</div>
<!-- Floating Glass Admin Navbar Dock -->
<header class="sticky top-4 z-50 max-w-[1080px] mx-auto px-4 sm:px-6">
<div class="h-14 px-4 sm:px-5 flex items-center justify-between rounded-full bg-white/75 backdrop-blur-2xl border border-white/80 shadow-[0_8px_30px_rgb(0,0,0,0.06)] ring-1 ring-black/[0.03]">
