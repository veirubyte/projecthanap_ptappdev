<body class="relative bg-[#f6f8fc] font-sans text-on-surface min-h-screen antialiased selection:bg-primary selection:text-white overflow-x-hidden">
<!-- Ambient Aurora Glow Canvas Mesh Blobs -->
<div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
<div class="absolute -top-32 left-1/4 w-[520px] h-[520px] bg-gradient-to-tr from-sky-200/50 via-indigo-200/40 to-teal-100/30 rounded-full blur-[100px] animate-pulse" style="animation-duration: 9s;"></div>
<div class="absolute top-1/3 -right-28 w-[460px] h-[460px] bg-gradient-to-br from-blue-200/45 via-purple-200/35 to-rose-100/30 rounded-full blur-[110px]"></div>
