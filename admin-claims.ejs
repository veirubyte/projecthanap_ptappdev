<div class="text-3xl font-extrabold tracking-tight text-secondary">2</div>
<div class="text-[11px] font-semibold text-on-surface-variant mt-1 uppercase tracking-wider">Guest Claims</div>
</div>
<!-- Tile 3: Frozen Dispute -->
