<button class="w-full sm:w-auto h-10 px-5 bg-gradient-to-r from-primary to-secondary hover:from-primary-container hover:to-secondary-container text-white text-xs font-semibold rounded-xl shrink-0 shadow-sm shadow-primary/30 hover:shadow-md transition-all flex items-center justify-center gap-1" type="submit">
