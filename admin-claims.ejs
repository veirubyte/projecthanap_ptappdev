<div class="absolute top-3.5 right-3.5 flex items-center gap-1.5">
<span class="relative flex h-2 w-2">
<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
<span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
</span>
<span class="material-symbols-outlined text-[19px] text-primary/70 group-hover:text-primary transition-colors">inventory_2</span>
</div>
<div class="text-3xl font-extrabold tracking-tight text-on-surface">18</div>
<div class="text-[11px] font-semibold text-on-surface-variant mt-1 uppercase tracking-wider">Vaulted Items</div>
