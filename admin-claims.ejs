<span class="w-7 h-7 rounded-lg bg-gradient-to-br from-primary to-secondary text-white flex items-center justify-center text-sm shadow-sm shadow-primary/30 group-hover:scale-105 transition-transform">
<span class="material-symbols-outlined text-[17px]">shield</span>
</span>
<span class="tracking-wide">HANAP</span>
</a>
<nav class="flex items-center gap-1">
<a aria-current="page" class="px-3 py-1.5 text-xs font-semibold rounded-full bg-primary text-white shadow-sm shadow-primary/25 transition-all" href="admin-claims.html">Dashboard</a>
<a class="px-3 py-1.5 text-xs font-medium rounded-full text-on-surface-variant hover:text-on-surface hover:bg-white/60 transition-colors" href="index.html">Browse Catalog</a>
<a class="px-3 py-1.5 text-xs font-medium rounded-full text-on-surface-variant hover:text-on-surface hover:bg-white/60 transition-colors" href="report.html">Report Item</a>
