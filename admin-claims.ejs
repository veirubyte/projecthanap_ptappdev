<span class="text-xs text-on-surface-variant shrink-0 flex items-center gap-1">📍 ComLab 3</span>
</div>
</div>
<a class="shrink-0 inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-white/90 hover:bg-white text-on-surface text-xs font-semibold rounded-lg border border-white/80 shadow-xs hover:shadow transition-all" href="#">
<span>Review Chat</span>
</a>
</div>
</div>
</section>
<!-- Bottom Quick Custody Intake Strip -->
<section class="p-4 sm:p-5 bg-white/70 backdrop-blur-2xl border border-white/80 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.03)] ring-1 ring-black/[0.02]">
<form class="flex flex-col sm:flex-row items-center gap-3" onsubmit="event.preventDefault();">
<input class="w-full sm:flex-1 h-10 px-3.5 text-xs bg-white/60 border border-white/80 rounded-xl text-on-surface placeholder:text-on-surface-variant/70 focus:ring-2 focus:ring-primary/20 focus:bg-white transition-all shadow-inner/5" placeholder="Item description" required="" type="text"/>
