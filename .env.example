# ==============================================================================
# PROJECT HANAP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and customize values for your local environment
# DO NOT commit real secrets or credentials to source control!
# ==============================================================================

# Application Port
PORT=3000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=project_hanap

# Session Security Secret
SESSION_SECRET=replace_with_a_strong_session_secret_key

# Gemini API (keep the API key server-side; never place it in browser code)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Node Environment ('development' or 'production')
NODE_ENV=development
