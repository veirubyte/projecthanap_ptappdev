# ==============================================================================
# PROJECT HANAP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and customize values for your local environment
# DO NOT commit real secrets or credentials to source control!
# ==============================================================================

# Application Port
PORT=3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=projecthanap_db

# Session Security Secret
SESSION_SECRET=replace_with_a_strong_session_secret_key

# Node Environment ('development' or 'production')
NODE_ENV=development
