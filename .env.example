# ==============================================================================
# PROJECT HANAP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and customize values for your environment.
# DO NOT commit real secrets or credentials to source control!
# ==============================================================================

# Application Port (Used in local development)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Session Security Secret (Generate a strong random string)
SESSION_SECRET=project_hanap_super_secure_session_secret_2026

# ==============================================================================
# OPTION A: SUPABASE POSTGRESQL CONFIGURATION (RECOMMENDED FOR VERCEL)
# ==============================================================================
# In Supabase Dashboard -> Project Settings -> Database -> Connection string:
# Direct Connection (Port 5432) or Transaction Pooler (Port 6543)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler:
# SUPABASE_DB_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Set to true for Supabase SSL connections
DB_SSL=true

# ==============================================================================
# OPTION B: LOCAL MYSQL CONFIGURATION (FOR LOCAL WORKSTATIONS)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=project_hanap

# ==============================================================================
# AI ASSISTANT CONFIGURATION (GOOGLE GEMINI)
# ==============================================================================
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ==============================================================================
# SMTP EMAIL CONFIGURATION (OPTIONAL FOR MFA & PASSWORD RESETS)
# ==============================================================================
# If unconfigured, MFA verification codes are printed to the server console.
SMTP_HOST=
SMTP_PORT=585
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Project HANAP" <no-reply@projecthanap.edu.ph>
