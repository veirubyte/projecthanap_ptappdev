<!DOCTYPE html>
<html class="hanap-hide-scrollbar hanap-reset-main-gutters" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <meta content="web_blank" name="shell-type"/>
  <title>Project HANAP - 403 Forbidden</title>
  <%- include('partials/themeSetup') %>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface-tint": "#33628b",
            "inverse-primary": "#9ecbfa",
            "on-error": "#ffffff",
            "on-tertiary": "#ffffff",
            "secondary": "#0058be",
            "surface-container-highest": "#dae2fd",
            "on-secondary-fixed-variant": "#004395",
            "on-tertiary-fixed": "#151c21",
            "error-container": "#ffdad6",
            "secondary-fixed": "#d8e2ff",
            "on-secondary-container": "#fefcff",
            "on-tertiary-fixed-variant": "#40484d",
            "primary-fixed": "#cfe5ff",
            "surface-container-low": "#f2f3ff",
            "error": "#ba1a1a",
            "tertiary-fixed": "#dce3ea",
            "secondary-fixed-dim": "#adc6ff",
            "background": "#F4F7FB",
            "primary-container": "#2b5b84",
            "outline-variant": "#c2c7cf",
            "on-secondary-fixed": "#001a42",
            "surface-container": "#eaedff",
            "surface-bright": "#faf8ff",
            "surface-container-lowest": "#ffffff",
            "tertiary-container": "#52595f",
            "on-error-container": "#93000a",
            "on-primary-container": "#a8d2ff",
            "primary": "#2B5B84",
            "on-primary": "#ffffff",
            "surface-variant": "#dae2fd",
            "on-surface-variant": "#42474e",
            "on-primary-fixed-variant": "#154a72",
            "on-secondary": "#ffffff",
            "on-surface": "#131b2e",
            "inverse-on-surface": "#eef0ff",
            "surface-container-high": "#e2e7ff",
            "secondary-container": "#2170e4",
            "on-primary-fixed": "#001d33",
            "primary-fixed-dim": "#9ecbfa",
            "on-tertiary-container": "#c8cfd6",
            "surface": "#ffffff",
            "inverse-surface": "#283044",
            "tertiary-fixed-dim": "#c0c7ce",
            "tertiary": "#3a4247",
            "on-background": "#131b2e",
            "outline": "#72777f",
            "surface-dim": "#d2d9f4"
          },
          borderRadius: {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          fontFamily: {
            sans: ["Plus Jakarta Sans", "sans-serif"]
          }
        }
      }
    };
  </script>
</head>
<body class="bg-[#F4F7FB] font-sans text-on-surface min-h-screen relative overflow-hidden selection:bg-rose-100 selection:text-rose-600">

  <main class="min-h-screen w-full flex items-center justify-center p-4 sm:p-6 relative isolate">
    <!-- Ambient Canvas Aurora Blur Blobs -->
    <div aria-hidden="true" class="absolute inset-0 -z-10 flex items-center justify-center overflow-hidden pointer-events-none">
      <div class="absolute -top-24 -left-20 w-[420px] h-[420px] rounded-full bg-rose-200/40 mix-blend-multiply blur-3xl opacity-70 animate-pulse" style="animation-duration: 8s;"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[520px] h-[460px] rounded-full bg-rose-100/60 blur-[100px] opacity-80"></div>
      <div class="absolute -bottom-24 -right-16 w-[440px] h-[440px] rounded-full bg-blue-200/35 mix-blend-multiply blur-3xl opacity-75"></div>
      <div class="absolute bottom-10 left-1/4 w-[360px] h-[360px] rounded-full bg-slate-200/45 blur-2xl opacity-60"></div>
    </div>

    <!-- Translucent Frosted Glass Shield Card -->
    <div class="w-full max-w-[540px] bg-white/85 backdrop-blur-2xl rounded-3xl border border-white/80 shadow-[0_24px_50px_-12px_rgba(30,58,138,0.12),0_8px_24px_-4px_rgba(225,29,72,0.06),inset_0_1px_1px_rgba(255,255,255,0.9)] p-8 sm:p-11 flex flex-col items-center text-center relative transition-all">
      
      <!-- Glowing response-status badge -->
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-rose-50/90 border border-rose-200/70 text-rose-600 shadow-[0_2px_8px_rgba(244,63,94,0.12)] text-xs font-semibold tracking-wide mb-6">
        <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">lock</span>
        <span><%= typeof httpStatus !== 'undefined' ? httpStatus : 403 %> <%= typeof statusLabel !== 'undefined' ? statusLabel : 'Forbidden' %></span>
      </div>

      <!-- 3D-styled Frosted Lock Shield Icon -->
      <div class="relative w-20 h-20 rounded-2xl bg-gradient-to-b from-rose-50 to-rose-100/70 border border-white/80 shadow-[0_12px_24px_-6px_rgba(244,63,94,0.22),inset_0_2px_4px_rgba(255,255,255,0.95)] flex items-center justify-center text-rose-600 mb-6 group">
        <div class="absolute inset-0 rounded-2xl bg-rose-400/10 blur-sm pointer-events-none"></div>
        <span class="material-symbols-outlined text-4xl relative z-10 drop-shadow-sm transition-transform duration-300 group-hover:scale-105" style="font-variation-settings: 'FILL' 1;">shield_lock</span>
      </div>

      <!-- Typography: Headline & Subtitle -->
      <h1 class="text-2xl sm:text-[26px] font-bold text-slate-900 tracking-tight mb-2">
        <%= typeof errorTitle !== 'undefined' ? errorTitle : 'Admin Access Only' %>
      </h1>
      <p class="text-sm text-slate-500 max-w-sm mb-6 leading-relaxed">
        <%= typeof errorMessage !== 'undefined' ? errorMessage : 'Your account cannot access administrative routes.' %>
      </p>

      <!-- Diagnostic Tag Pill -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-50/80 border border-slate-200/80 text-xs text-slate-600 mb-8 font-mono shadow-[inset_0_1px_2px_rgba(0,0,0,0.02)] backdrop-blur-sm">
        <span>Attempted: <span class="font-semibold text-slate-800"><%= typeof attemptedPath !== 'undefined' ? attemptedPath : 'Unknown route' %></span></span>
        <span class="text-slate-300">•</span>
        <span>Role: <span class="font-semibold text-slate-800"><%= user ? (['admin', 'administrator'].includes(String(user.role || '').toLowerCase()) ? 'Administrator' : (user.role === 'student' ? 'Student' : (user.role === 'staff' ? 'Staff' : (user.role === 'parent' ? 'Parent / Guardian' : 'Guest')))) : 'Guest' %></span></span>
      </div>

      <!-- Tactile Gradient Action Button with Specular Highlight and Glow -->
      <a class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl bg-gradient-to-r from-[#2B5B84] to-[#1E40AF] hover:from-[#244c6e] hover:to-[#1a3899] text-white font-medium text-sm transition-all duration-200 shadow-[0_10px_20px_-5px_rgba(43,91,132,0.38),inset_0_1px_1px_rgba(255,255,255,0.3)] active:translate-y-[1px] active:shadow-[0_4px_10px_-2px_rgba(43,91,132,0.35)]" href="<%= typeof returnUrl !== 'undefined' ? returnUrl : '/dashboard' %>">
        <span class="material-symbols-outlined text-lg">arrow_back</span>
        <span><%= typeof returnLabel !== 'undefined' ? returnLabel : 'Back to Dashboard' %></span>
      </a>

      <% if (!user) { %>
        <a class="mt-3 text-xs text-slate-500 hover:text-slate-800 transition" href="/login">
          Sign in with an admin account &rarr;
        </a>
      <% } %>
    </div>
  </main>
</body>
</html>
