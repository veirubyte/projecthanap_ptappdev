<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Project HANAP - Reports &amp; 60-Day Archive</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            brand: "#2B5B84",
            "brand-dark": "#09436b",
            "page-bg": "#faf8ff"
          },
          fontFamily: {
            sans: ["Plus Jakarta Sans", "sans-serif"]
          }
        }
      }
    };
  </script>
  
  <%- include('partials/themeSetup') %>
</head>
<body class="admin-reports-page font-sans text-slate-800 min-h-screen flex flex-col justify-between antialiased relative overflow-x-hidden selection:bg-sky-500/20">

  <!-- Ambient Aurora Glow Canvas Blobs -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
    <div class="absolute -top-32 -left-32 w-[520px] h-[520px] rounded-full bg-gradient-to-br from-sky-400/20 via-blue-500/15 to-transparent dark:from-sky-500/15 dark:via-blue-500/10 blur-3xl transform -rotate-12"></div>
    <div class="absolute top-1/4 -right-24 w-[460px] h-[460px] rounded-full bg-gradient-to-bl from-indigo-300/25 via-sky-300/15 to-transparent dark:from-indigo-500/15 dark:via-sky-500/10 blur-3xl"></div>
    <div class="absolute bottom-10 left-1/3 w-[560px] h-[400px] rounded-full bg-gradient-to-tr from-cyan-200/20 via-blue-400/10 to-transparent dark:from-cyan-500/15 dark:via-blue-500/10 blur-3xl"></div>
  </div>

  <%- include('partials/navbar', { active: 'admin-reports' }) %>

  <!-- Main Layout -->
  <main class="w-full flex-grow py-3 relative z-10">
    <div class="max-w-[1280px] w-full mx-auto px-4 sm:px-6 xl:px-8 flex flex-col gap-6">
      
      <!-- Main Content Area -->
      <div class="min-w-0 flex-1 w-full flex flex-col gap-5">
      
      <!-- Top Header Strip -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-7">
        <div>
          <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Archive &amp; Audit Trail</h1>
          <p class="text-xs text-slate-500 mt-0.5">Manage 60-day item disposition and audit trails.</p>
        </div>
        <div class="flex items-center gap-2.5">
          <a
            href="/admin/reports/export-csv"
            download="hanap_reports_ledger.csv"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-white/80 bg-white/70 backdrop-blur-md text-xs font-semibold text-slate-700 hover:bg-white shadow-[0_2px_8px_rgba(0,0,0,0.04)] transition-all cursor-pointer"
            id="exportModalBtn"
            data-csv="<%= reports ? reports.map(function(r) { return r.id + ',&quot;' + r.item_name + '&quot;,&quot;' + r.location_found_lost + '&quot;,' + r.status + ',&quot;' + r.reporter_name + '&quot;'; }).join('\n') : '' %>"
          >
            <span class="material-symbols-outlined text-[16px]">download</span>
            <span>Export CSV</span>
          </a>
          <button class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-[#09436b] to-[#2B5B84] hover:from-[#073656] hover:to-[#224869] text-white text-xs font-semibold shadow-[0_4px_16px_rgba(9,67,107,0.25)] border border-sky-300/30 transition-all hover:scale-[1.01] active:scale-[0.99] cursor-pointer" id="batchApproveBtn">
            <span class="material-symbols-outlined text-[16px]">done_all</span>
            <span>✓ Approve Archive Batch</span>
          </button>
        </div>
      </div>

      <!-- 4 Glowing Admin Glass Bento KPI Tiles -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-7">
        <!-- 1: Total Reports -->
        <div class="bg-white/60 backdrop-blur-xl p-4 rounded-2xl border border-white/80 shadow-[0_8px_24px_rgba(9,67,107,0.05)] hover:shadow-[0_12px_28px_rgba(9,67,107,0.08)] transition-all">
          <span class="text-xs font-medium text-slate-500 block mb-1">Total Reports</span>
          <div class="text-2xl font-bold text-slate-900 tracking-tight"><%= stats ? stats.totalReports : reports.length %></div>
        </div>
        <!-- 2: Recovery Rate (with glowing seafoam indicator) -->
        <div class="bg-white/60 backdrop-blur-xl p-4 rounded-2xl border border-white/80 shadow-[0_8px_24px_rgba(9,67,107,0.05)] hover:shadow-[0_12px_28px_rgba(9,67,107,0.08)] transition-all relative overflow-hidden">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-medium text-slate-500">Recovery Rate</span>
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-600 border border-emerald-200/60 shadow-[0_0_8px_rgba(16,185,129,0.3)]">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Optimal
            </span>
          </div>
          <div class="text-2xl font-bold text-slate-900 tracking-tight"><%= stats ? stats.recoveryRate : '86' %>%</div>
        </div>
        <!-- 3: Peer Returns -->
        <div class="bg-white/60 backdrop-blur-xl p-4 rounded-2xl border border-white/80 shadow-[0_8px_24px_rgba(9,67,107,0.05)] hover:shadow-[0_12px_28px_rgba(9,67,107,0.08)] transition-all">
          <span class="text-xs font-medium text-slate-500 block mb-1">Peer Returns</span>
          <div class="text-2xl font-bold text-slate-900 tracking-tight"><%= stats ? stats.peerReturns : '94' %></div>
        </div>
        <!-- 4: Desk Handovers -->
        <div class="bg-white/60 backdrop-blur-xl p-4 rounded-2xl border border-white/80 shadow-[0_8px_24px_rgba(9,67,107,0.05)] hover:shadow-[0_12px_28px_rgba(9,67,107,0.08)] transition-all">
          <span class="text-xs font-medium text-slate-500 block mb-1">Desk Handovers</span>
          <div class="text-2xl font-bold text-slate-900 tracking-tight"><%= stats ? stats.deskHandovers : '28' %></div>
        </div>
      </div>

      <!-- Glass Tabbed Matrix Table -->
      <div class="bg-white/70 backdrop-blur-xl rounded-2xl border border-white/80 shadow-[0_12px_36px_rgba(9,67,107,0.07)] overflow-hidden">
        <!-- Tab Navigation -->
        <div class="flex items-center border-b border-slate-200/60 px-6 pt-3 bg-white/40">
          <button class="tab-btn px-4 py-2.5 text-xs font-semibold border-b-2 border-[#2B5B84] text-[#09436b] transition-colors cursor-pointer" id="tabQueueBtn" data-tab="queue" aria-selected="true">
            60-Day Archive Queue (<%= archiveQueue ? archiveQueue.length : 3 %>)
          </button>
          <button class="tab-btn px-4 py-2.5 text-xs font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition-colors cursor-pointer" id="tabAuditBtn" data-tab="audit" aria-selected="false">
            System Audit Trail
          </button>
          <button class="tab-btn px-4 py-2.5 text-xs font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition-colors cursor-pointer" id="tabAllBtn" data-tab="all" aria-selected="false">
            All Campus Reports (<%= reports ? reports.length : 0 %>)
          </button>
        </div>

        <!-- Tab 1: 60-Day Archive Queue -->
        <div class="divide-y divide-slate-100/80" id="queueTabContent">
          <% if (!archiveQueue || archiveQueue.length === 0) { %>
            <div class="p-8 text-center text-xs text-slate-400">
              No items currently pending 60-day disposition.
            </div>
          <% } else { %>
            <% archiveQueue.forEach(item => { %>
              <div class="p-4 sm:px-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-white/60 transition-colors">
                <div class="flex items-center gap-3.5">
                  <% if (item.primary_image_path) { %>
                    <img class="w-11 h-11 rounded-xl object-cover border border-white shadow-sm shrink-0" src="<%= item.primary_image_path %>" alt="<%= item.item_name %>"/>
                  <% } else { %>
                    <div class="w-11 h-11 rounded-xl bg-slate-100 border border-slate-200/80 shadow-sm shrink-0 flex items-center justify-center text-slate-400">
                      <span class="material-symbols-outlined text-[20px]">inventory_2</span>
                    </div>
                  <% } %>
                  <div>
                    <h4 class="text-xs font-semibold text-slate-900"><%= item.item_name %></h4>
                    <div class="flex items-center gap-2 mt-0.5 text-[11px] text-slate-500">
                      <span class="text-rose-600 font-medium"><%= item.daysActive || 65 %> days overdue</span>
                      <span>•</span>
                      <span><%= item.location_found_lost %></span>
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-3 self-end sm:self-center">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold bg-sky-50/90 text-[#09436b] border border-sky-200/60 shadow-[0_0_10px_rgba(56,189,248,0.2)]">
                    <%= item.status === 'archived' ? 'Archived' : (item.category === 'Electronics' ? 'Queued for Donation' : 'Student Desk') %>
                  </span>
                  <% if (item.status === 'archived') { %>
                    <span class="px-3.5 py-1.5 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold shadow-sm">
                      Approved
                    </span>
                  <% } else { %>
                    <button class="px-3.5 py-1.5 rounded-xl bg-white/80 hover:bg-[#2B5B84] hover:text-white border border-slate-200/80 text-slate-700 text-xs font-semibold transition-all shadow-sm row-approve-btn cursor-pointer" data-id="<%= item.id %>">
                      Approve
                    </button>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>

        <!-- Tab 2: System Audit Trail -->
        <div class="hidden divide-y divide-slate-100/80" id="auditTabContent">
          <div class="p-3 sm:px-6 bg-slate-50/70 border-b border-slate-100 flex items-center justify-between">
            <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Recent System Audit Events</span>
            <a href="/admin/audit-logs" class="inline-flex items-center gap-1 text-xs font-bold text-[#09436b] hover:text-[#2B5B84] transition">
              <span>Open Dedicated Audit Log Viewer</span>
              <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
            </a>
          </div>
          <% if (!auditLogs || auditLogs.length === 0) { %>
            <!-- Default mock audit entries from mockup -->
            <div class="p-4 sm:px-6 flex items-center justify-between gap-4 hover:bg-white/60 transition-colors">
              <div>
                <div class="text-xs font-semibold text-slate-900">Handover Verified</div>
                <div class="text-[11px] text-slate-500">Case #G-309 • Smartphone</div>
              </div>
              <span class="text-[11px] text-slate-400">Today, 02:45 PM</span>
            </div>
            <div class="p-4 sm:px-6 flex items-center justify-between gap-4 hover:bg-white/60 transition-colors">
              <div>
                <div class="text-xs font-semibold text-rose-600">Dispute Frozen</div>
                <div class="text-[11px] text-slate-500">Case #D-881 • Casio Calculator</div>
              </div>
              <span class="text-[11px] text-slate-400">Today, 01:15 PM</span>
            </div>
            <div class="p-4 sm:px-6 flex items-center justify-between gap-4 hover:bg-white/60 transition-colors">
              <div>
                <div class="text-xs font-semibold text-slate-900">Quota Reset</div>
                <div class="text-[11px] text-slate-500">Student ID: 2023-1104-NB</div>
              </div>
              <span class="text-[11px] text-slate-400">Today, 11:30 AM</span>
            </div>
            <div class="p-4 sm:px-6 flex items-center justify-between gap-4 hover:bg-white/60 transition-colors">
              <div>
                <div class="text-xs font-semibold text-slate-900">Item Surrendered</div>
                <div class="text-[11px] text-slate-500">Case #F-2490 • CCS Lanyard</div>
              </div>
              <span class="text-[11px] text-slate-400">Today, 10:30 AM</span>
            </div>
          <% } else { %>
            <% auditLogs.forEach(log => { %>
              <div class="p-4 sm:px-6 flex items-center justify-between gap-4 hover:bg-white/60 transition-colors">
                <div>
                  <div class="text-xs font-semibold text-slate-900"><%= log.action_description || log.action %></div>
                  <div class="text-[11px] text-slate-500">Admin: <%= log.admin_name || 'System Officer' %> • IP: <%= log.ip_address || '127.0.0.1' %></div>
                </div>
                <span class="text-[11px] text-slate-400"><%= typeof timeAgo === 'function' ? timeAgo(log.timestamp) : new Date(log.timestamp).toLocaleTimeString() %></span>
              </div>
            <% }) %>
          <% } %>
        </div>

        <!-- Tab 3: All Campus Reports Matrix -->
        <div class="hidden overflow-x-auto" id="allTabContent">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="border-b border-slate-200/60 text-slate-500 font-semibold bg-white/40">
                <th class="py-3 px-5">Case / Item</th>
                <th class="py-3 px-4">Type</th>
                <th class="py-3 px-4">Location</th>
                <th class="py-3 px-4">Status</th>
                <th class="py-3 px-4">Reporter</th>
                <th class="py-3 px-5 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100/80">
              <% if (!reports || reports.length === 0) { %>
                <tr>
                  <td colspan="6" class="py-8 text-center text-slate-400">No reports recorded.</td>
                </tr>
              <% } else { %>
                <% reports.forEach(r => { %>
                  <tr class="hover:bg-white/70 transition-colors">
                    <td class="py-3.5 px-5">
                      <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-slate-100 border border-slate-200/70 flex items-center justify-center text-[#2B5B84] shrink-0 overflow-hidden">
                          <% if (r.primary_image_path) { %>
                            <img src="<%= r.primary_image_path %>" alt="" class="w-full h-full object-cover"/>
                          <% } else { %>
                            <span class="material-symbols-outlined text-lg">category</span>
                          <% } %>
                        </div>
                        <div class="flex flex-col min-w-0">
                          <span class="font-bold text-sm text-slate-900 truncate"><%= r.item_name %></span>
                          <span class="text-[11px] text-slate-400">#<%= r.report_type === 'found' ? 'F' : 'L' %>-<%= r.id %> • <%= r.category %></span>
                        </div>
                      </div>
                    </td>
                    <td class="py-3.5 px-4">
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= r.report_type === 'found' ? 'bg-teal-100 text-teal-800' : 'bg-rose-100 text-rose-800' %>">
                        <%= r.report_type %>
                      </span>
                    </td>
                    <td class="py-3.5 px-4 text-slate-600">
                      <span class="inline-flex items-center gap-1.5"><i data-lucide="map-pin" class="w-3.5 h-3.5 text-rose-500"></i> <%= r.location_found_lost %></span>
                    </td>
                    <td class="py-3.5 px-4">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold <%= r.status === 'claimed' ? 'bg-emerald-100 text-emerald-800' : (r.status === 'archived' ? 'bg-slate-200 text-slate-700' : 'bg-blue-50 text-blue-800 border border-blue-200/50') %> capitalize">
                        <%= r.status %>
                      </span>
                    </td>
                    <td class="py-3.5 px-4 text-slate-600">
                      <%= r.reporter_name %>
                    </td>
                    <td class="py-3.5 px-5 text-right">
                      <div class="flex items-center justify-end gap-1.5">
                        <a href="/items/<%= r.id %>" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 shadow-2xs transition">
                          View
                        </a>
                        <a href="/items/<%= r.id %>/edit" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-sky-50 hover:bg-sky-100 text-sky-800 border border-sky-200 shadow-2xs transition">
                          Edit
                        </a>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    </div>
  </main>

  <!-- Minimal Glass Footer -->
  <footer class="w-full border-t border-slate-200/60 bg-white/60 backdrop-blur-md py-4 mt-8 relative z-10">
    <div class="max-w-[1080px] mx-auto px-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-2">
      <span>Project HANAP • Campus Security &amp; OSA</span>
      <span>Ledger Academic Year 2026-2027</span>
    </div>
  </footer>

  <!-- Notification Toast -->
  <div class="fixed bottom-5 right-5 z-50 transform translate-y-16 opacity-0 transition-all duration-300 pointer-events-none" id="toastNotification">
    <div class="flex items-center gap-2 bg-slate-900/90 backdrop-blur-md text-white px-4 py-2.5 rounded-xl shadow-xl text-xs font-medium border border-slate-700/50">
      <span class="material-symbols-outlined text-[16px] text-emerald-400" id="toastIcon">check_circle</span>
      <span id="toastMessage">Action completed.</span>
    </div>
  </div>

  <script>
    function switchTab(tab) {
      const queueTab = document.getElementById('queueTabContent');
      const auditTab = document.getElementById('auditTabContent');
      const allTab = document.getElementById('allTabContent');
      const queueBtn = document.getElementById('tabQueueBtn');
      const auditBtn = document.getElementById('tabAuditBtn');
      const allBtn = document.getElementById('tabAllBtn');

      if (!queueTab || !auditTab || !queueBtn || !auditBtn) return;

      const tabs = {
        queue: { panel: queueTab, button: queueBtn },
        audit: { panel: auditTab, button: auditBtn },
        all: { panel: allTab, button: allBtn }
      };

      Object.values(tabs).forEach(({ panel, button }) => {
        if (panel) panel.classList.add('hidden');
        if (button) {
          button.className = 'tab-btn px-4 py-2.5 text-xs font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition-colors cursor-pointer';
          button.setAttribute('aria-selected', 'false');
        }
      });

      const selected = tabs[tab];
      if (selected && selected.panel) {
        selected.panel.classList.remove('hidden');
      }
      if (selected && selected.button) {
        selected.button.className = 'tab-btn px-4 py-2.5 text-xs font-semibold border-b-2 border-[#2B5B84] text-[#09436b] transition-colors cursor-pointer';
        selected.button.setAttribute('aria-selected', 'true');
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const tabButtons = document.querySelectorAll('.tab-btn');
      tabButtons.forEach((button) => {
        const key = button.id.replace('tab', '').replace('Btn', '').toLowerCase();
        if (button.id === 'tabQueueBtn') button.setAttribute('aria-selected', 'true');
        button.addEventListener('click', () => switchTab(key === 'queue' ? 'queue' : key === 'audit' ? 'audit' : 'all'));
      });
    });

    const showToast = (message) => {
      const toast = document.getElementById('toastNotification');
      const toastMsg = document.getElementById('toastMessage');
      if (!toast) return;
      toastMsg.textContent = message;
      toast.classList.remove('translate-y-16', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-16', 'opacity-0');
      }, 3000);
    };

    const exportBtn = document.getElementById('exportModalBtn');
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        showToast('Exporting CSV ledger...');
      });
    }

    const csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
    const batchApproveBtn = document.getElementById('batchApproveBtn');
    if (batchApproveBtn) {
      batchApproveBtn.addEventListener('click', async () => {
        try {
          const res = await fetch('/admin/reports/batch-approve', {
            credentials: 'same-origin',
            method: 'POST',
            headers: { 'Accept': 'application/json', 'x-csrf-token': csrfToken }
          });
          if (!res.ok) throw new Error('Request failed');
          showToast('Archive batch approved.');
          setTimeout(() => location.reload(), 1000);
        } catch (e) {
          showToast('Error approving batch.');
        }
      });
    }

    document.querySelectorAll('.row-approve-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const itemId = btn.getAttribute('data-id');
        try {
          if (itemId) {
            const res = await fetch(`/admin/reports/${itemId}/archive-approve`, {
              credentials: 'same-origin',
              method: 'POST',
              headers: { 'Accept': 'application/json', 'x-csrf-token': csrfToken }
            });
            if (!res.ok) throw new Error('Request failed');
          }
          btn.textContent = 'Approved';
          btn.className = 'px-3.5 py-1.5 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold transition-all shadow-sm';
          showToast('Item approved for disposition.');
        } catch (e) {
          showToast('Error approving item.');
        }
      });
    });
  </script>
</body>
</html>
