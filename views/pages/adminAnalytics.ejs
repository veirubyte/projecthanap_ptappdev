<!DOCTYPE html>
<html class="hanap-hide-scrollbar" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Statistical Overview: P2P vs Centralized Custody — Project HANAP</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#09436b",
            "primary-container": "#2b5b84",
            "secondary": "#0058be",
            "surface": "#faf8ff",
            "on-surface": "#131b2e",
            "on-surface-variant": "#42474e",
            "background": "#faf8ff"
          },
          fontFamily: {
            sans: ["Plus Jakarta Sans", "sans-serif"]
          }
        }
      }
    };
  </script>
  <%- include('partials/themeSetup') %>
</head>
<body class="bg-[#f4f7fb] font-sans text-on-surface min-h-screen antialiased relative overflow-x-hidden selection:bg-secondary/15 flex flex-col justify-between">
  
  <!-- Ambient Aurora Mesh Canvas Glows -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-[18%] -left-[10%] w-[55vw] h-[55vw] rounded-full bg-gradient-to-br from-blue-300/35 via-indigo-200/25 to-transparent blur-[120px]"></div>
    <div class="absolute top-[20%] -right-[15%] w-[50vw] h-[50vw] rounded-full bg-gradient-to-bl from-sky-200/35 via-teal-100/30 to-transparent blur-[130px]"></div>
    <div class="absolute -bottom-[20%] left-[25%] w-[45vw] h-[45vw] rounded-full bg-gradient-to-t from-purple-200/25 via-blue-100/25 to-transparent blur-[110px]"></div>
  </div>

  <%- include('partials/navbar', { active: 'admin-analytics' }) %>

  <!-- Main Container -->
  <main class="relative z-10 w-full pt-2 pb-14">
    <div class="max-w-[1280px] w-full mx-auto px-4 sm:px-6 xl:px-8 flex flex-col gap-6">
      
      <!-- Main Content Area -->
      <div class="min-w-0 flex-1 w-full flex flex-col gap-6">
        
        <!-- Top Section Header Strip -->
        <div class="bg-white/70 backdrop-blur-xl border border-white/80 rounded-2xl p-6 shadow-[0_8px_30px_rgb(9,67,107,0.05)] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-sky-50 text-sky-700 border border-sky-200/60">
                <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                Operational Efficiency Ledger
              </span>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">P2P vs Centralized Desk Analysis</h1>
            <p class="text-xs text-slate-500 mt-1 max-w-xl">
              Comparative effectiveness analysis evaluating decentralized Peer-to-Peer claim resolution versus centralized Campus Security Vault custody operations.
            </p>
          </div>

          <div class="flex items-center gap-2 self-start sm:self-center">
            <span class="px-3 py-1.5 rounded-xl bg-slate-100 text-xs font-semibold text-slate-700 border border-slate-200">
              AY 2026-2027
            </span>
          </div>
        </div>

        <!-- Head-to-Head Comparative Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          
          <!-- Card 1: Peer-to-Peer (P2P) Effectiveness Model -->
          <div class="bg-white/80 backdrop-blur-2xl rounded-3xl p-6 sm:p-7 border border-white/90 shadow-[0_12px_40px_rgba(9,67,107,0.06)] flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute -top-12 -right-12 w-36 h-36 bg-blue-100/50 rounded-full blur-2xl group-hover:scale-125 transition-transform duration-500"></div>
            
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-3">
                  <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-[#0058be] to-[#38BDF8] flex items-center justify-center text-white shadow-sm">
                    <span class="material-symbols-outlined text-[22px]">diversity_3</span>
                  </div>
                  <div>
                    <h2 class="text-base font-bold text-slate-900">Peer-to-Peer (P2P)</h2>
                    <span class="text-[11px] text-slate-500 font-medium">Decentralized Student Resolution</span>
                  </div>
                </div>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                  <%= p2p.successRate %>% Rate
                </span>
              </div>

              <p class="text-xs text-slate-600 leading-relaxed mb-6">
                <%= p2p.description %>
              </p>

              <!-- Metrics Matrix Bento -->
              <div class="grid grid-cols-3 gap-3 mb-6">
                <div class="p-3.5 rounded-2xl bg-slate-50/80 border border-slate-100 flex flex-col">
                  <span class="text-[10px] font-semibold text-slate-400 uppercase">P2P Claimed</span>
                  <span class="text-xl font-bold text-slate-900 mt-0.5"><%= p2p.approved %></span>
                  <span class="text-[10px] text-emerald-600 font-medium mt-1">Verified</span>
                </div>
                <div class="p-3.5 rounded-2xl bg-slate-50/80 border border-slate-100 flex flex-col">
                  <span class="text-[10px] font-semibold text-slate-400 uppercase">Active / In-Chat</span>
                  <span class="text-xl font-bold text-slate-900 mt-0.5"><%= p2p.pending %></span>
                  <span class="text-[10px] text-amber-600 font-medium mt-1">Pending</span>
                </div>
                <div class="p-3.5 rounded-2xl bg-slate-50/80 border border-slate-100 flex flex-col">
                  <span class="text-[10px] font-semibold text-slate-400 uppercase">Turnaround</span>
                  <span class="text-xl font-bold text-slate-900 mt-0.5"><%= p2p.avgHours %></span>
                  <span class="text-[10px] text-sky-600 font-medium mt-1">Fast Return</span>
                </div>
              </div>

              <!-- Workflow Checkpoints -->
              <div class="flex flex-col gap-2 pt-2 border-t border-slate-100 text-xs">
                <div class="flex items-center gap-2 text-slate-600">
                  <span class="material-symbols-outlined text-[16px] text-emerald-500">check_circle</span>
                  <span>Secret challenge answer match validation protects ownership</span>
                </div>
                <div class="flex items-center gap-2 text-slate-600">
                  <span class="material-symbols-outlined text-[16px] text-emerald-500">check_circle</span>
                  <span>Direct peer chat enables seamless campus handover</span>
                </div>
                <div class="flex items-center gap-2 text-slate-600">
                  <span class="material-symbols-outlined text-[16px] text-emerald-500">check_circle</span>
                  <span>Zero storage burden on Security Command Vault</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 2: Centralized Admin Desk Model -->
          <div class="bg-white/80 backdrop-blur-2xl rounded-3xl p-6 sm:p-7 border border-white/90 shadow-[0_12px_40px_rgba(9,67,107,0.06)] flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute -top-12 -right-12 w-36 h-36 bg-teal-100/50 rounded-full blur-2xl group-hover:scale-125 transition-transform duration-500"></div>
            
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-3">
                  <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-[#09436b] to-[#2B5B84] flex items-center justify-center text-white shadow-sm">
                    <span class="material-symbols-outlined text-[22px]">admin_panel_settings</span>
                  </div>
                  <div>
                    <h2 class="text-base font-bold text-slate-900">Centralized Desk</h2>
                    <span class="text-[11px] text-slate-500 font-medium">Security Vault Custody</span>
                  </div>
                </div>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                  <%= centralized.successRate %>% Rate
                </span>
              </div>

              <p class="text-xs text-slate-600 leading-relaxed mb-6">
                <%= centralized.description %>
              </p>

              <!-- Metrics Matrix Bento -->
              <div class="grid grid-cols-3 gap-3 mb-6">
                <div class="p-3.5 rounded-2xl bg-slate-50/80 border border-slate-100 flex flex-col">
                  <span class="text-[10px] font-semibold text-slate-400 uppercase">Desk Handover</span>
                  <span class="text-xl font-bold text-slate-900 mt-0.5"><%= centralized.approved %></span>
                  <span class="text-[10px] text-emerald-600 font-medium mt-1">Released</span>
                </div>
                <div class="p-3.5 rounded-2xl bg-slate-50/80 border border-slate-100 flex flex-col">
                  <span class="text-[10px] font-semibold text-slate-400 uppercase">In-Vault Queue</span>
                  <span class="text-xl font-bold text-slate-900 mt-0.5"><%= centralized.pending %></span>
                  <span class="text-[10px] text-amber-600 font-medium mt-1">Security Hold</span>
                </div>
                <div class="p-3.5 rounded-2xl bg-slate-50/80 border border-slate-100 flex flex-col">
                  <span class="text-[10px] font-semibold text-slate-400 uppercase">ID Verification</span>
                  <span class="text-xl font-bold text-slate-900 mt-0.5">100%</span>
                  <span class="text-[10px] text-sky-600 font-medium mt-1">Physical ID</span>
                </div>
              </div>

              <!-- Workflow Checkpoints -->
              <div class="flex flex-col gap-2 pt-2 border-t border-slate-100 text-xs">
                <div class="flex items-center gap-2 text-slate-600">
                  <span class="material-symbols-outlined text-[16px] text-emerald-500">check_circle</span>
                  <span>Physical check of government ID, student COR, or staff badge</span>
                </div>
                <div class="flex items-center gap-2 text-slate-600">
                  <span class="material-symbols-outlined text-[16px] text-emerald-500">check_circle</span>
                  <span>Guest &amp; parent claims securely resolved at the physical counter</span>
                </div>
                <div class="flex items-center gap-2 text-slate-600">
                  <span class="material-symbols-outlined text-[16px] text-emerald-500">check_circle</span>
                  <span>Full digital chain-of-custody logged with officer signature</span>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- System Volume Distribution & Category Analysis -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          
          <!-- 1: Claim Distribution Pie / Ratio Breakdown -->
          <div class="bg-white/75 backdrop-blur-xl border border-white/80 rounded-2xl p-5 shadow-[0_8px_30px_rgb(9,67,107,0.05)] flex flex-col justify-between">
            <div>
              <span class="text-xs font-bold text-slate-800 block mb-1">Claim Routing Ratio</span>
              <p class="text-[11px] text-slate-500">Volume distribution across recovery pathways.</p>
              
              <div class="my-5 flex flex-col gap-3">
                <div>
                  <div class="flex justify-between text-xs font-semibold text-slate-700 mb-1">
                    <span>P2P Peer Resolution</span>
                    <span><%= Math.round((p2p.approved / (p2p.approved + centralized.approved || 1)) * 100) %>%</span>
                  </div>
                  <div class="w-full h-3 rounded-full bg-slate-100 overflow-hidden">
                    <div class="h-full rounded-full bg-gradient-to-r from-blue-500 to-sky-400 transition-all duration-500" data-progress="<%= Math.round((p2p.approved / (p2p.approved + centralized.approved || 1)) * 100) %>%"></div>
                  </div>
                </div>

                <div>
                  <div class="flex justify-between text-xs font-semibold text-slate-700 mb-1">
                    <span>Centralized Security Handover</span>
                    <span><%= Math.round((centralized.approved / (p2p.approved + centralized.approved || 1)) * 100) %>%</span>
                  </div>
                  <div class="w-full h-3 rounded-full bg-slate-100 overflow-hidden">
                    <div class="h-full rounded-full bg-gradient-to-r from-[#09436b] to-[#2B5B84] transition-all duration-500" data-progress="<%= Math.round((centralized.approved / (p2p.approved + centralized.approved || 1)) * 100) %>%"></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 text-[11px] text-slate-600">
              💡 <strong>Takeaway:</strong> P2P resolves majority of student items quickly, while Centralized Desk prevents disputes on high-value items.
            </div>
          </div>

          <!-- 2: Top Recovered Item Categories -->
          <div class="md:col-span-2 bg-white/75 backdrop-blur-xl border border-white/80 rounded-2xl p-5 shadow-[0_8px_30px_rgb(9,67,107,0.05)] flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-bold text-slate-800">Top Claimed Categories</span>
                <span class="text-[11px] text-slate-400">AY 2026-2027</span>
              </div>
              <p class="text-[11px] text-slate-500 mb-4">Volume of successful claim resolutions grouped by item type.</p>

              <div class="space-y-3">
                <% categories.forEach(cat => { %>
                  <div class="flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2.5 w-1/3">
                      <span class="w-2 h-2 rounded-full bg-sky-500"></span>
                      <span class="font-medium text-slate-700 truncate"><%= cat.category %></span>
                    </div>
                    <div class="w-1/2 h-2 rounded-full bg-slate-100 overflow-hidden mx-2">
                      <div class="h-full rounded-full bg-[#2B5B84] transition-all duration-500" data-progress="<%= Math.min(100, Math.round((cat.claim_count / 10) * 100)) %>%"></div>
                    </div>
                    <span class="w-12 text-right font-bold text-slate-900"><%= cat.claim_count %> cases</span>
                  </div>
                <% }) %>
              </div>
            </div>

            <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
              <span>Total campus items cataloged: <strong><%= reports ? reports.total_reports : 0 %></strong></span>
              <a href="/admin/reports" class="text-sky-700 hover:underline font-semibold">View Master Archive &rarr;</a>
            </div>
          </div>

        </div>

      </div>

    </div>
  </main>

  <!-- Minimal Glass Footer -->
  <footer class="w-full border-t border-slate-200/60 bg-white/60 backdrop-blur-md py-4 relative z-10">
    <div class="max-w-[1280px] mx-auto px-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-2">
      <span>Project HANAP • Campus Security &amp; Office of Student Affairs</span>
      <span>Ledger Academic Year 2026-2027</span>
    </div>
  </footer>

  <!-- Dynamic Progress Bar Width Initialization -->
  <script>
    const updateProgressBars = () => {
      document.querySelectorAll('[data-progress]').forEach((bar) => {
        bar.style.width = bar.getAttribute('data-progress');
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateProgressBars);
    } else {
      updateProgressBars();
    }
  </script>
</body>
</html>
