<!DOCTYPE html>
<html class="h-full hanap-hide-scrollbar" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Edit Report #<%= item.report_type === 'found' ? 'F' : 'L' %>-<%= item.id %> - Project HANAP CSPC</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#09436b",
            "primary-container": "#2b5b84",
            "on-primary": "#ffffff",
            "secondary": "#0058be",
            "surface": "#faf8ff",
            "on-surface": "#131b2e",
            "on-surface-variant": "#42474e",
            "error": "#ba1a1a"
          },
          fontFamily: {
            sans: ["Plus Jakarta Sans", "sans-serif"]
          }
        }
      }
    };
  </script>
  <%- include('partials/themeSetup') %>
</head>
<body class="min-h-full bg-slate-50 font-sans text-on-surface antialiased flex flex-col justify-between relative overflow-x-hidden">
  
  <!-- Ambient Aurora Glowing Mesh Canvas -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
    <div class="absolute -top-32 -left-32 w-[550px] h-[550px] rounded-full bg-gradient-to-br from-blue-300/40 via-sky-200/30 to-transparent blur-3xl animate-pulse" style="animation-duration: 8s;"></div>
    <div class="absolute top-1/4 -right-40 w-[600px] h-[600px] rounded-full bg-gradient-to-bl from-indigo-200/45 via-blue-200/35 to-teal-100/20 blur-3xl"></div>
    <div class="absolute -bottom-36 left-1/3 w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-cyan-200/40 via-sky-100/30 to-transparent blur-3xl"></div>
  </div>

  <% const isUserAdmin = typeof isAdmin !== 'undefined' ? Boolean(isAdmin) : (typeof user !== 'undefined' && user && user.role === 'admin'); %>
  <%- include('partials/navbar', { active: isUserAdmin ? 'admin-reports' : 'catalog' }) %>

  <main class="w-full pt-4 sm:pt-6 pb-16 flex-1 flex items-center justify-center px-4 sm:px-6 relative z-10">
    <!-- Elevated Floating Frosted Glass Modal Card -->
    <div class="w-full max-w-[640px] bg-white/85 backdrop-blur-2xl rounded-2xl sm:rounded-3xl shadow-[0_20px_50px_rgba(15,23,42,0.08),0_1px_0_rgba(255,255,255,0.95)_inset,0_0_0_1px_rgba(255,255,255,0.8)] border border-white/60 p-4 sm:p-7 md:p-9 flex flex-col gap-6 transition-all relative">
      
      <!-- Flash Messages -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs sm:text-sm flex items-center gap-2.5">
          <span class="material-symbols-outlined text-rose-600 text-[18px]">error</span>
          <span><%= error %></span>
        </div>
      <% } %>
      <% if (typeof msg !== 'undefined' && msg) { %>
        <div class="p-3.5 rounded-2xl bg-teal-50 border border-teal-200 text-teal-800 text-xs sm:text-sm flex items-center gap-2.5">
          <span class="material-symbols-outlined text-teal-600 text-[18px]">check_circle</span>
          <span><%= msg %></span>
        </div>
      <% } %>

      <!-- Header with Title, Pill and Sleek Close Icon -->
      <div class="flex items-start justify-between pb-4 border-b border-slate-100/80">
        <div class="flex items-center gap-3 flex-wrap">
          <h1 class="text-[22px] font-bold text-on-surface tracking-tight leading-none">Edit Report</h1>
          <span class="px-2.5 py-0.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-semibold tracking-wide">
            #<%= item.report_type === 'found' ? 'F' : 'L' %>-<%= item.id %>
          </span>
          <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase <%= item.report_type === 'found' ? 'bg-teal-50 text-teal-800 border border-teal-200/60' : 'bg-rose-50 text-rose-800 border border-rose-200/60' %>">
            <%= item.report_type %>
          </span>
          <% if (item.custody_mode) { %>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-700 border border-slate-200">
              <i data-lucide="<%= item.custody_mode === 'security_desk' ? 'shield' : 'users' %>" class="w-3 h-3 inline mr-1"></i>
              <%= item.custody_mode === 'security_desk' ? 'Security Custody' : 'Peer Meetup' %>
            </span>
          <% } %>
        </div>
        <a aria-label="Close" class="w-8 h-8 rounded-full flex items-center justify-center text-on-surface-variant/70 hover:text-on-surface hover:bg-slate-100/80 active:scale-95 transition-all -mr-1" href="/items/<%= item.id %>">
          <span class="material-symbols-outlined text-[20px]">close</span>
        </a>
      </div>

      <!-- Form Inputs Container -->
      <form class="flex flex-col gap-4.5" id="editReportForm" action="/items/<%= item.id %>/edit" method="POST" enctype="multipart/form-data">
        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
        <% } %>
        <input type="hidden" name="status" id="status-input" value="<%= item.status || 'active' %>"/>

        <!-- 1. Title -->
        <div class="flex flex-col gap-1.5">
          <label class="text-[13px] font-semibold text-on-surface" for="item-title">Title</label>
          <div class="relative flex items-center group">
            <input 
              class="w-full h-11 px-3.5 rounded-xl border border-slate-200/80 bg-white/70 backdrop-blur-md text-on-surface text-[14px] shadow-sm focus:bg-white focus:border-primary focus:ring-4 focus:ring-primary/10 focus:outline-none transition-all placeholder:text-slate-400" 
              id="item-title" 
              name="item_name" 
              type="text" 
              value="<%= item.item_name %>" 
              required
            />
          </div>
        </div>

        <!-- 2. Description -->
        <div class="flex flex-col gap-1.5">
          <label class="text-[13px] font-semibold text-on-surface" for="item-description">Description &amp; Distinguishing Details</label>
          <textarea class="w-full min-h-24 p-3.5 rounded-xl border border-slate-200/80 bg-white/70 backdrop-blur-md text-on-surface text-[14px] shadow-sm focus:bg-white focus:border-primary focus:ring-4 focus:ring-primary/10 focus:outline-none transition-all placeholder:text-slate-400" id="item-description" name="description" required><%= item.description || '' %></textarea>
        </div>

        <!-- 3. Category & Status -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Category -->
          <div class="flex flex-col gap-1.5">
            <label class="text-[13px] font-semibold text-on-surface" for="category-select">Category</label>
            <div class="relative flex items-center">
              <select 
                class="w-full h-11 px-3.5 pr-9 rounded-xl border border-slate-200/80 bg-white/70 backdrop-blur-md text-on-surface text-[14px] appearance-none shadow-sm focus:bg-white focus:border-primary focus:ring-4 focus:ring-primary/10 focus:outline-none transition-all cursor-pointer" 
                id="category-select" 
                name="category"
              >
                <% const categoryOptions = (typeof categories !== 'undefined' && Array.isArray(categories) && categories.length) ? categories : ['Electronics', 'IDs & Cards', 'Keys & Lanyards', 'Bags & Wallets', 'Books & Notes', 'Clothing & Wearables', 'Tumblers & Bottles', 'Accessories', 'Others']; %>
                <% categoryOptions.forEach(cat => { %>
                  <option value="<%= cat %>" <%= (item.category === cat) ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
              </select>
              <span class="material-symbols-outlined text-[20px] text-on-surface-variant/70 absolute right-3 pointer-events-none">expand_more</span>
            </div>
          </div>

          <!-- Status Segmented Pill Selector -->
          <div class="flex flex-col gap-1.5">
            <label class="text-[13px] font-semibold text-on-surface">Status</label>
            <div class="grid grid-cols-3 p-1 rounded-xl bg-slate-100/80 border border-slate-200/60 backdrop-blur-md shadow-inner gap-1 h-11 items-center" id="statusButtonGroup">
              <button 
                type="button" 
                data-status="active" 
                class="status-btn h-8 rounded-lg text-[12px] font-semibold flex items-center justify-center transition-all <%= (item.status === 'active' || !item.status) ? 'bg-white text-primary shadow-sm border border-slate-200/60' : 'text-on-surface-variant hover:text-on-surface' %>"
              >
                Active
              </button>
              <button 
                type="button" 
                data-status="pending_review" 
                class="status-btn h-8 rounded-lg text-[11px] font-semibold flex items-center justify-center transition-all <%= item.status === 'pending_review' ? 'bg-white text-primary shadow-sm border border-slate-200/60' : 'text-on-surface-variant hover:text-on-surface' %>"
              >
                In Verification
              </button>
              <button 
                type="button" 
                data-status="returned" 
                class="status-btn h-8 rounded-lg text-[12px] font-semibold flex items-center justify-center transition-all <%= item.status === 'returned' ? 'bg-white text-primary shadow-sm border border-slate-200/60' : 'text-on-surface-variant hover:text-on-surface' %>"
              >
                Returned
              </button>
            </div>
          </div>
        </div>

        <!-- 4. Campus Location -->
        <div class="flex flex-col gap-1.5">
          <label class="text-[13px] font-semibold text-on-surface" for="campus-location">Campus Location</label>
          <div class="relative flex items-center group">
            <span class="material-symbols-outlined text-[19px] text-on-surface-variant/60 absolute left-3.5 pointer-events-none">location_on</span>
            <input 
              class="w-full h-11 pl-10 pr-3.5 rounded-xl border border-slate-200/80 bg-white/70 backdrop-blur-md text-on-surface text-[14px] shadow-sm focus:bg-white focus:border-primary focus:ring-4 focus:ring-primary/10 focus:outline-none transition-all placeholder:text-slate-400" 
              id="campus-location" 
              name="location_found_lost" 
              type="text" 
              value="<%= item.location_found_lost %>" 
              required
            />
          </div>
        </div>

        <!-- 5. Existing and Additional Photos -->
        <div class="flex flex-col gap-2">
          <label class="text-[13px] font-semibold text-on-surface" for="report-photos">Photos</label>
          <% if (typeof itemImages !== 'undefined' && itemImages.length > 0) { %>
            <div class="flex flex-wrap gap-2">
              <% itemImages.forEach(image => { %>
                <img class="w-16 h-16 rounded-lg object-cover border border-slate-200" src="<%= image.image_path %>" alt="Current item photo"/>
              <% }) %>
            </div>
          <% } %>
          <input class="w-full text-xs text-on-surface-variant" id="report-photos" name="photos" type="file" accept="image/jpeg,image/png,image/webp" multiple/>
          <p class="text-[11px] text-on-surface-variant">Add up to <%= Math.max(0, 6 - (typeof itemImages !== 'undefined' ? itemImages.length : 0)) %> more photos (JPEG, PNG, or WebP; 5 MB max each). Existing photos are kept.</p>
        </div>

        <% 
          const existingPairs = (typeof challengePairs !== 'undefined' && challengePairs && challengePairs.length) 
            ? challengePairs 
            : [{ question: item.secret_challenge || '', answer: item.secret_answer || '' }];
        %>
        <!-- Verification Challenge Pod -->
        <div class="flex flex-col gap-3 p-4 rounded-2xl bg-white/60 border border-slate-200/80 shadow-xs">
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 text-primary font-bold text-sm">
              <span class="material-symbols-outlined text-[20px]">key</span>
              <span>Ownership Verification Challenge (Optional)</span>
            </div>
            <span id="questionCountBadge" class="text-[11px] font-semibold text-slate-500 bg-white border border-slate-200 px-2.5 py-0.5 rounded-full shadow-2xs">
              <%= existingPairs.length %> of 5 questions
            </span>
          </div>
          <p class="text-[11px] text-on-surface-variant -mt-1">
            Optional. Add private questions and their correct answers. For each question added, enter both or leave both blank. Claimants never see the answers.
          </p>

          <!-- Dynamic Questions Container -->
          <div id="questionsContainer" class="flex flex-col gap-3">
            <% existingPairs.forEach((pair, idx) => { %>
              <div class="question-row p-3 rounded-xl bg-white border border-slate-200/90 shadow-2xs flex flex-col gap-2 transition-all" data-question-index="<%= idx %>">
                <div class="flex items-center justify-between">
                  <span class="question-label text-xs font-bold text-primary flex items-center gap-1.5">
                    <span class="w-5 h-5 rounded-full bg-[#09436B] text-white flex items-center justify-center text-[10px] font-bold question-number"><%= idx + 1 %></span>
                    <span>Question <%= idx + 1 %></span>
                  </span>
                  <button type="button" class="remove-question-btn <%= existingPairs.length <= 1 ? 'hidden' : '' %> text-rose-500 hover:text-rose-700 p-1 rounded-lg hover:bg-rose-50 text-xs font-semibold flex items-center gap-1 transition-colors cursor-pointer" aria-label="Remove question">
                    <span class="material-symbols-outlined text-[16px]">delete</span>
                    <span>Remove</span>
                  </button>
                </div>
                <div class="relative flex items-center">
                  <span class="material-symbols-outlined text-[18px] text-slate-400 absolute left-3 pointer-events-none">help_outline</span>
                  <input 
                    class="ownership-challenge-input w-full h-10 pl-9 pr-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-800 text-xs sm:text-sm focus:bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all" 
                    name="secret_challenges[]" 
                    type="text" 
                    placeholder="e.g. What specific pin is attached to the clip?" 
                    value="<%= pair.question %>"
                    maxlength="500"
                  />
                </div>
                <div class="relative flex items-center">
                  <span class="material-symbols-outlined text-[18px] text-slate-400 absolute left-3 pointer-events-none">lock</span>
                  <input 
                    class="ownership-answer-input w-full h-10 pl-9 pr-10 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-800 text-xs sm:text-sm focus:bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all" 
                    name="secret_answers[]" 
                    type="password" 
                    autocomplete="off"
                    placeholder="Private correct answer" 
                    value="<%= pair.answer %>"
                    maxlength="500"
                  />
                  <button type="button" data-toggle-answer class="toggle-answer-btn absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100/80 cursor-pointer z-10" aria-label="Toggle answer visibility">
                    <span class="material-symbols-outlined text-[18px] leading-none toggle-answer-icon pointer-events-none">visibility</span>
                  </button>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- Add Question Button Row -->
          <div class="flex items-center justify-between pt-1 border-t border-slate-200/60">
            <button type="button" id="addQuestionBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-sky-300 bg-sky-50 hover:bg-sky-100 text-[#09436B] text-xs font-bold transition shadow-2xs cursor-pointer">
              <span class="material-symbols-outlined text-[18px]">add_circle</span>
              <span>+ Add Another Question</span>
            </button>
            <span id="questionLimitNote" class="text-[11px] text-slate-400 font-medium">Max 5 questions</span>
          </div>
        </div>

        <!-- Bottom Action Row -->
        <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-end gap-2.5 sm:gap-3 pt-3 border-t border-slate-100/80">
          <a class="px-5 h-10 inline-flex items-center justify-center rounded-xl border border-slate-200/80 bg-white/70 hover:bg-slate-100/80 text-on-surface font-semibold text-sm transition-all active:scale-[0.98] text-center" href="/items/<%= item.id %>">
            Cancel
          </a>
          <button 
            type="submit" 
            class="px-6 h-10 inline-flex items-center justify-center gap-1.5 rounded-xl bg-gradient-to-r from-[#2B5B84] to-[#1E40AF] hover:from-[#234b6e] hover:to-[#1a3899] text-white font-semibold text-sm shadow-[0_4px_16px_rgba(43,91,132,0.35)] hover:shadow-[0_6px_22px_rgba(43,91,132,0.45)] active:scale-[0.98] transition-all cursor-pointer" 
            id="btn-save-report"
          >
            <span class="material-symbols-outlined text-[18px]">check</span>
            <span>Save Changes</span>
          </button>
        </div>
      </form>
    </div>
  </main>

  <!-- Frosted Glass Footer Dock -->
  <footer class="w-full bg-white/60 backdrop-blur-lg border-t border-white/60">
    <div class="max-w-6xl mx-auto px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <div class="w-5 h-5 rounded-md bg-sky-100 flex items-center justify-center text-primary shadow-xs">
          <span class="material-symbols-outlined text-[13px]">explore</span>
        </div>
        <span class="text-sm font-semibold text-primary">Project HANAP</span>
        <span class="text-xs text-on-surface-variant">— CSPC</span>
      </div>
      <div class="text-xs text-on-surface-variant text-center sm:text-right">
        © 2026 CSPC Student Council &amp; IT Services.
      </div>
    </div>
  </footer>

  <script>
    // Multi-Question Management in Edit View
    const questionsContainer = document.getElementById('questionsContainer');
    const addQuestionBtn = document.getElementById('addQuestionBtn');
    const questionCountBadge = document.getElementById('questionCountBadge');
    const questionLimitNote = document.getElementById('questionLimitNote');
    const MAX_QUESTIONS = 5;

    function bindAnswerToggle(row) {
      const toggleBtn = row.querySelector('.toggle-answer-btn');
      const answerInput = row.querySelector('.ownership-answer-input');
      if (toggleBtn && answerInput) {
        toggleBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const isPw = answerInput.type === 'password';
          answerInput.type = isPw ? 'text' : 'password';
          const icon = row.querySelector('.toggle-answer-icon') || row.querySelector('.toggle-answer-btn [data-lucide], .toggle-answer-btn svg, .toggle-answer-btn span');
          if (icon) {
            if (icon.tagName && icon.tagName.toLowerCase() === 'svg') {
              const newIcon = document.createElement('i');
              newIcon.setAttribute('data-lucide', isPw ? 'eye-off' : 'eye');
              newIcon.className = (icon.className.baseVal || icon.className) + ' pointer-events-none';
              icon.replaceWith(newIcon);
              if (window.lucide && typeof window.lucide.createIcons === 'function') {
                window.lucide.createIcons();
              }
            } else {
              icon.setAttribute('data-lucide', isPw ? 'eye-off' : 'eye');
              icon.textContent = isPw ? 'visibility_off' : 'visibility';
            }
          }
          toggleBtn.setAttribute('aria-label', isPw ? 'Hide answer' : 'Show answer');
        });
      }
    }

    function updateQuestionsState() {
      if (!questionsContainer) return;
      const rows = questionsContainer.querySelectorAll('.question-row');
      const count = rows.length;
      if (questionCountBadge) {
        questionCountBadge.textContent = `${count} of ${MAX_QUESTIONS} question${count === 1 ? '' : 's'}`;
      }
      rows.forEach((row, idx) => {
        row.dataset.questionIndex = idx;
        const numEl = row.querySelector('.question-number');
        const labelSpan = row.querySelector('.question-label span:last-child');
        if (numEl) numEl.textContent = idx + 1;
        if (labelSpan) labelSpan.textContent = `Question ${idx + 1}`;

        const removeBtn = row.querySelector('.remove-question-btn');
        if (removeBtn) {
          removeBtn.classList.toggle('hidden', count <= 1);
        }
      });

      if (addQuestionBtn) {
        if (count >= MAX_QUESTIONS) {
          addQuestionBtn.disabled = true;
          addQuestionBtn.classList.add('opacity-50', 'cursor-not-allowed');
          if (questionLimitNote) questionLimitNote.textContent = 'Maximum reached';
        } else {
          addQuestionBtn.disabled = false;
          addQuestionBtn.classList.remove('opacity-50', 'cursor-not-allowed');
          if (questionLimitNote) questionLimitNote.textContent = 'Max 5 questions';
        }
      }
    }

    function addQuestionRow(initialQ = '', initialA = '') {
      if (!questionsContainer) return;
      const currentCount = questionsContainer.querySelectorAll('.question-row').length;
      if (currentCount >= MAX_QUESTIONS) return;

      const row = document.createElement('div');
      row.className = 'question-row p-3 rounded-xl bg-white border border-slate-200/90 shadow-2xs flex flex-col gap-2 transition-all';
      row.dataset.questionIndex = currentCount;
      row.innerHTML = `
        <div class="flex items-center justify-between">
          <span class="question-label text-xs font-bold text-primary flex items-center gap-1.5">
            <span class="w-5 h-5 rounded-full bg-[#09436B] text-white flex items-center justify-center text-[10px] font-bold question-number">${currentCount + 1}</span>
            <span>Question ${currentCount + 1}</span>
          </span>
          <button type="button" class="remove-question-btn text-rose-500 hover:text-rose-700 p-1 rounded-lg hover:bg-rose-50 text-xs font-semibold flex items-center gap-1 transition-colors cursor-pointer" aria-label="Remove question">
            <span class="material-symbols-outlined text-[16px]">delete</span>
            <span>Remove</span>
          </button>
        </div>
        <div class="relative flex items-center">
          <span class="material-symbols-outlined text-[18px] text-slate-400 absolute left-3 pointer-events-none">help_outline</span>
          <input 
            class="ownership-challenge-input w-full h-10 pl-9 pr-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-800 text-xs sm:text-sm focus:bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all" 
            name="secret_challenges[]" 
            type="text" 
            placeholder="e.g. What specific pin is attached to the clip?" 
            maxlength="500"
          />
        </div>
        <div class="relative flex items-center">
          <span class="material-symbols-outlined text-[18px] text-slate-400 absolute left-3 pointer-events-none">lock</span>
          <input 
            class="ownership-answer-input w-full h-10 pl-9 pr-10 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-800 text-xs sm:text-sm focus:bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all" 
            name="secret_answers[]" 
            type="password" 
            autocomplete="off"
            placeholder="Private correct answer" 
            maxlength="500"
          />
          <button type="button" data-toggle-answer class="toggle-answer-btn absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100/80 cursor-pointer z-10" aria-label="Toggle answer visibility">
                    <span class="material-symbols-outlined text-[18px] leading-none toggle-answer-icon pointer-events-none">visibility</span>
                  </button>
        </div>
      `;

      const qInput = row.querySelector('.ownership-challenge-input');
      const aInput = row.querySelector('.ownership-answer-input');
      if (initialQ) qInput.value = initialQ;
      if (initialA) aInput.value = initialA;

      const removeBtn = row.querySelector('.remove-question-btn');
      removeBtn.addEventListener('click', () => {
        row.remove();
        updateQuestionsState();
      });

      bindAnswerToggle(row);
      questionsContainer.appendChild(row);
      updateQuestionsState();
      qInput.focus();
    }

    if (addQuestionBtn) {
      addQuestionBtn.addEventListener('click', () => addQuestionRow());
    }

    if (questionsContainer) {
      const rows = questionsContainer.querySelectorAll('.question-row');
      rows.forEach((row) => {
        bindAnswerToggle(row);
        const removeBtn = row.querySelector('.remove-question-btn');
        if (removeBtn) {
          removeBtn.addEventListener('click', () => {
            row.remove();
            updateQuestionsState();
          });
        }
      });
      updateQuestionsState();
    }

    const editForm = document.querySelector('form[action*="/items/"]');
    if (editForm && questionsContainer) {
      editForm.addEventListener('submit', (e) => {
        const rows = questionsContainer.querySelectorAll('.question-row');
        for (const row of rows) {
          const q = row.querySelector('.ownership-challenge-input').value.trim();
          const a = row.querySelector('.ownership-answer-input').value.trim();
          if ((q && !a) || (!q && a)) {
            e.preventDefault();
            alert('Please enter both the question and its private answer, or leave both blank.');
            (q ? row.querySelector('.ownership-answer-input') : row.querySelector('.ownership-challenge-input')).focus();
            return;
          }
        }
      });
    }

    // Segmented Status Pill Selector Sync
    const statusInput = document.getElementById('status-input');
    const statusButtons = document.querySelectorAll('.status-btn');
    statusButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-status');
        statusInput.value = selected;
        statusButtons.forEach(b => {
          b.className = 'status-btn h-8 rounded-lg text-[12px] font-semibold flex items-center justify-center transition-all text-on-surface-variant hover:text-on-surface';
        });
        btn.className = 'status-btn h-8 rounded-lg text-[12px] font-semibold flex items-center justify-center transition-all bg-white text-primary shadow-sm border border-slate-200/60';
      });
    });
  </script>
</body>
</html>
