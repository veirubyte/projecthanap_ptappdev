<!DOCTYPE html>
<html class="hanap-hide-scrollbar" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Custody Handover - Project HANAP</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#09436b",
            "primary-container": "#2b5b84",
            "secondary": "#0058be",
            "surface": "#faf8ff",
            "on-surface": "#131b2e",
            "on-surface-variant": "#42474e",
            "error": "#ba1a1a",
            "error-container": "#ffdad6",
            "background": "#faf8ff"
          },
          fontFamily: {
            sans: ["Plus Jakarta Sans", "sans-serif"]
          }
        }
      }
    };
  </script>
  <%- include('partials/themeSetup') %>
</head>
<body class="bg-[#faf8ff] font-sans text-on-surface min-h-screen flex flex-col justify-between relative overflow-x-hidden">
  
  <!-- Ambient Canvas Aurora Blobs -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-300/25 rounded-full blur-[100px] animate-pulse"></div>
    <div class="absolute top-1/3 -right-24 w-[30rem] h-[30rem] bg-[#09436B]/15 rounded-full blur-[120px]"></div>
    <div class="absolute -bottom-24 left-1/3 w-[28rem] h-[28rem] bg-indigo-200/25 rounded-full blur-[110px]"></div>
  </div>

  <%- include('partials/navbar', { active: 'admin-handover' }) %>

  <!-- Main Container -->
  <main class="w-full pt-2 pb-16 flex-1 relative z-10">
    <div class="max-w-[1280px] w-full mx-auto px-4 sm:px-6 xl:px-8 flex flex-col gap-6">
      
      <!-- Handover Terminal Content -->
      <div class="min-w-0 flex-1 w-full flex items-center justify-center">
    
    <% if (typeof claim !== 'undefined' && claim) { %>
      <!-- Centered Digital Verification Pad Card (from ZIP C) -->
      <div class="w-full bg-white/85 backdrop-blur-2xl rounded-3xl shadow-[0_20px_60px_-15px_rgba(15,23,42,0.12)] border border-white/90 p-5 sm:p-7 lg:p-9 flex flex-col gap-6 transition-all">
        
        <!-- Flash Messages -->
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-center gap-2">
            <span class="material-symbols-outlined text-[16px]">error</span>
            <span><%= error %></span>
          </div>
        <% } %>

        <!-- Terminal Header -->
        <div class="flex flex-col border-b border-slate-200/80 pb-5">
          <div class="flex items-center justify-between">
            <h1 class="text-2xl font-bold text-on-surface tracking-tight">Custody Handover</h1>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100/80 backdrop-blur-md border border-slate-200/80 text-xs font-semibold text-primary shadow-xs">
              <span class="material-symbols-outlined text-[16px] text-secondary">inventory_2</span>
              <span>Vault #B-<%= claim.item_id %></span>
            </span>
          </div>
          <p class="text-xs text-on-surface-variant mt-1.5 font-medium">
            Ticket #G-<%= claim.id %> • <%= claim.item_name %>
          </p>
        </div>

        <!-- Interactive Verification Protocol Pods -->
        <div class="flex flex-col gap-3">
          <span class="text-xs uppercase tracking-wider text-on-surface-variant font-bold">Verification Protocol</span>
          <div class="space-y-2.5">
            <!-- Tap-to-verify Pod 1 -->
            <label class="group flex items-center gap-3.5 p-3.5 rounded-2xl bg-slate-50/70 hover:bg-white border border-slate-200/70 hover:border-secondary/40 shadow-xs cursor-pointer transition-all duration-200">
              <input checked class="w-5 h-5 rounded-lg text-secondary focus:ring-secondary/30 accent-secondary cursor-pointer transition-transform group-hover:scale-105" type="checkbox"/>
              <span class="text-xs sm:text-sm text-on-surface font-medium select-none flex-1">Physical item matches report description &amp; identifiers</span>
              <span class="material-symbols-outlined text-secondary text-[18px]">verified</span>
            </label>
            <!-- Tap-to-verify Pod 2 -->
            <label class="group flex items-center gap-3.5 p-3.5 rounded-2xl bg-slate-50/70 hover:bg-white border border-slate-200/70 hover:border-secondary/40 shadow-xs cursor-pointer transition-all duration-200">
              <input checked class="w-5 h-5 rounded-lg text-secondary focus:ring-secondary/30 accent-secondary cursor-pointer transition-transform group-hover:scale-105" type="checkbox"/>
              <span class="text-xs sm:text-sm text-on-surface font-medium select-none flex-1">Claimant ownership statement confirmed in custody desk log</span>
              <span class="material-symbols-outlined text-secondary text-[18px]">verified</span>
            </label>
          </div>
        </div>

        <!-- Claimant Proof Details -->
        <div class="p-3.5 rounded-2xl bg-amber-50/80 border border-amber-200/70 text-xs">
          <span class="font-bold text-amber-900 block mb-0.5">Claimant Proof of Ownership:</span>
          <p class="text-slate-800 leading-relaxed font-medium">"<%= claim.proof_details %>"</p>
        </div>

        <!-- Claimant Identity Row -->
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-on-surface" for="claimant-id">Claimant Identity &amp; Credentials</label>
          <div class="relative">
            <input 
              class="w-full h-12 px-4 rounded-2xl bg-slate-50/90 text-xs sm:text-sm text-on-surface font-mono border border-slate-200/80 focus:bg-white focus:outline-none transition-all pr-12 shadow-inner" 
              id="claimant-id" 
              readonly 
              type="text" 
              value="<%= claim.claimant_name %> (<%= claim.claimant_role %>) • Email: <%= claim.claimant_email %>"
            />
            <div class="absolute right-3.5 top-3 w-6 h-6 rounded-lg bg-secondary/10 flex items-center justify-center text-secondary">
              <span class="material-symbols-outlined text-[18px]">badge</span>
            </div>
          </div>
        </div>

        <!-- Officer Verification Pill -->
        <div class="flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-slate-50/80 border border-slate-200/70 backdrop-blur-md">
          <div class="w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center text-primary">
            <span class="material-symbols-outlined text-[16px]">verified</span>
          </div>
          <span class="text-xs text-on-surface-variant">
            Verified by: <strong class="text-on-surface font-semibold">Officer <%= user.full_name %></strong> • Just now
          </span>
        </div>

        <!-- Action Row -->
        <div class="flex flex-col gap-3 pt-2">
          <!-- Confirm Release Form -->
          <form action="/admin/handover/<%= claim.id %>/confirm" method="POST">
            <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
            <% } %>
            <button 
              type="submit" 
              class="w-full h-12 rounded-2xl text-white text-xs sm:text-sm font-semibold flex items-center justify-center gap-2 bg-gradient-to-r from-[#2B5B84] to-[#1E40AF] hover:brightness-110 active:scale-[0.99] transition-all shadow-[0_8px_20px_rgba(33,112,228,0.28)] cursor-pointer"
            >
              <span class="material-symbols-outlined text-[20px]">check_circle</span>
              <span>Confirm Release &amp; Complete Handover</span>
            </button>
          </form>

          <!-- Reject Claim Button -->
          <button 
            type="button" 
            onclick="triggerRejectModal()" 
            class="w-full h-12 rounded-2xl bg-[#fee2e2]/75 hover:bg-[#fecaca] text-[#b91c1c] border border-rose-200/60 text-xs sm:text-sm font-semibold flex items-center justify-center gap-2 transition-all active:scale-[0.99] shadow-xs cursor-pointer"
          >
            <span class="material-symbols-outlined text-[20px]">gpp_bad</span>
            <span>Reject Claim</span>
          </button>

          <!-- Back Link -->
          <div class="text-center pt-1">
            <a class="inline-flex items-center gap-1.5 text-xs text-on-surface-variant hover:text-primary transition-colors py-1 font-medium" href="/admin/dashboard">
              <span class="material-symbols-outlined text-[16px]">arrow_back</span>
              <span>Back to Dashboard</span>
            </a>
          </div>
        </div>

        <!-- Rejection Modal -->
        <div class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-md hidden items-center justify-center p-4 transition-all" id="rejectModal">
          <div class="bg-white/95 backdrop-blur-2xl max-w-sm w-full rounded-3xl p-6 shadow-2xl border border-white/80 flex flex-col gap-4">
            <div class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-800 flex items-center justify-center shadow-xs">
              <span class="material-symbols-outlined text-[24px]">warning</span>
            </div>
            <div>
              <h3 class="text-base font-bold text-on-surface">Reject Claim</h3>
              <p class="text-xs text-on-surface-variant mt-1">Ticket #G-<%= claim.id %> will remain held in custody.</p>
            </div>
            <div class="flex items-center justify-end gap-2.5 pt-2">
              <button class="px-4 py-2 rounded-xl bg-slate-100 text-xs font-semibold text-on-surface hover:bg-slate-200 transition-colors" onclick="triggerRejectModal()" type="button">Cancel</button>
              <form action="/admin/handover/<%= claim.id %>/reject" method="POST">
                <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                <% } %>
                <button type="submit" class="px-4 py-2 rounded-xl bg-rose-600 text-white text-xs font-bold hover:bg-rose-700 shadow-sm transition-colors cursor-pointer">
                  Confirm Rejection
                </button>
              </form>
            </div>
          </div>
        </div>

      </div>

    <% } else { %>
      <!-- Pending Handover Queue Selection Card -->
      <div class="w-full bg-white/85 backdrop-blur-2xl rounded-3xl shadow-[0_20px_60px_-15px_rgba(15,23,42,0.08)] border border-white/90 p-5 sm:p-7 lg:p-9 flex flex-col gap-6">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Physical Handover Terminal</h1>
            <p class="text-xs text-slate-500">Select a pending guest claim or disputed item to execute custody release.</p>
          </div>
          <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold">
            <%= pendingHandovers ? pendingHandovers.length : 0 %> Pending
          </span>
        </div>

        <% if (!pendingHandovers || pendingHandovers.length === 0) { %>
          <div class="py-12 text-center text-slate-400 text-xs">
            <span class="material-symbols-outlined text-4xl mb-2 text-slate-300">task_alt</span>
            <p class="font-semibold text-slate-700">All custody handovers completed!</p>
            <p class="text-slate-400 mt-1">No items currently waiting for security release.</p>
            <a href="/admin/dashboard" class="inline-flex items-center gap-1.5 px-4 py-2 mt-4 rounded-xl bg-primary text-white font-semibold transition">
              <span>Return to Dashboard</span>
            </a>
          </div>
        <% } else { %>
          <div class="divide-y divide-slate-100">
            <% pendingHandovers.forEach(h => { %>
              <div class="py-4 flex items-center justify-between gap-4 hover:bg-slate-50/50 p-2 rounded-2xl transition">
                <div class="flex items-center gap-3.5 min-w-0">
                  <div class="w-12 h-12 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-[#2B5B84] shrink-0 overflow-hidden">
                    <% if (h.image_path) { %>
                      <img src="<%= h.image_path %>" alt="" class="w-full h-full object-cover"/>
                    <% } else { %>
                      <span class="material-symbols-outlined text-2xl">category</span>
                    <% } %>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-sm text-slate-900 truncate"><%= h.item_name %></span>
                    <span class="text-xs text-slate-500">
                      Claimant: <strong><%= h.claimant_name %></strong> (<%= h.claimant_role %>) • Ticket #G-<%= h.id %>
                    </span>
                  </div>
                </div>
                <a href="/admin/handover/<%= h.id %>" class="px-4 py-2 rounded-xl bg-gradient-to-r from-primary to-secondary text-white text-xs font-semibold shadow-xs hover:brightness-110 transition flex items-center gap-1">
                  <span>Open Terminal</span>
                  <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } %>

      </div>
    </div>
  </main>

  <footer class="w-full bg-white/70 backdrop-blur-xl border-t border-white/80 relative z-10">
    <div class="max-w-[1240px] mx-auto px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-on-surface-variant">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-primary text-[18px]">verified_user</span>
        <span>CSPC Campus Security System — Custody Terminal</span>
      </div>
      <div>© Project HANAP.</div>
    </div>
  </footer>

  <script>
    function triggerRejectModal() {
      const modal = document.getElementById('rejectModal');
      if (modal) {
        if (modal.classList.contains('hidden')) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        } else {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      }
    }
  </script>
</body>
</html>
