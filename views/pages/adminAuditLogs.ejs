<!DOCTYPE html>
<html class="light" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Security Audit Logs - CSPC Admin</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <%- include('../partials/themeSetup') %>
  <style>
    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 450, 'GRAD' 0, 'opsz' 24; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col selection:bg-blue-600/15 selection:text-blue-700 relative overflow-x-hidden">
  <!-- Ambient Background Blobs -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="absolute -top-[18%] -left-[10%] w-[55vw] h-[55vw] rounded-full bg-gradient-to-br from-blue-300/30 via-indigo-200/20 to-transparent blur-[120px]"></div>
    <div class="absolute top-[20%] -right-[15%] w-[50vw] h-[50vw] rounded-full bg-gradient-to-bl from-sky-200/30 via-teal-100/20 to-transparent blur-[130px]"></div>
  </div>

  <%- include('../partials/navbar', { active: 'admin-reports' }) %>

  <main class="relative z-10 flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200 text-xs font-bold uppercase tracking-wider mb-2">
          <span class="material-symbols-outlined text-[15px]">policy</span>
          Immutable Governance Ledger
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">System Security & Audit Logs</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Chronological record of administrative actions, custody releases, role assignments, and archive dispositions.
        </p>
      </div>
      <div class="flex items-center gap-2.5">
        <a href="/admin/dashboard" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-xs font-semibold shadow-sm transition-all">
          <span class="material-symbols-outlined text-[16px]">arrow_back</span>
          Admin Console
        </a>
      </div>
    </div>

    <!-- Search & Ledger Card -->
    <div class="bg-white/85 backdrop-blur-xl rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="p-5 sm:px-6 border-b border-slate-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="relative w-full sm:max-w-xs">
          <span class="material-symbols-outlined text-[18px] text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2">search</span>
          <input
            type="text"
            id="auditSearchInput"
            placeholder="Filter by officer, action, or IP..."
            class="w-full pl-10 pr-4 py-2 rounded-xl border border-slate-200 bg-slate-50/70 text-xs text-slate-800 placeholder:text-slate-400 focus:bg-white focus:border-blue-600 focus:ring-2 focus:ring-blue-600/10 focus:outline-none"
          />
        </div>
        <div class="text-xs font-semibold text-slate-500">
          Total Logged Events: <span class="text-slate-900 font-bold"><%= logs ? logs.length : 0 %></span>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50/80 text-slate-500 font-bold uppercase tracking-wider border-b border-slate-200/70">
            <tr>
              <th class="py-3.5 px-6">Log ID</th>
              <th class="py-3.5 px-6">Administrator</th>
              <th class="py-3.5 px-6">Action Description</th>
              <th class="py-3.5 px-6">IP Address</th>
              <th class="py-3.5 px-6 text-right">Timestamp</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200/60" id="auditTableBody">
            <% if (!logs || logs.length === 0) { %>
              <tr>
                <td colspan="5" class="py-12 text-center text-slate-400 font-medium">
                  No administrative audit logs recorded yet.
                </td>
              </tr>
            <% } else { %>
              <% logs.forEach(log => { %>
                <tr class="audit-row hover:bg-slate-50/80 transition-colors">
                  <td class="py-3.5 px-6 font-mono font-semibold text-slate-500">#<%= log.id %></td>
                  <td class="py-3.5 px-6">
                    <div class="font-semibold text-slate-900"><%= log.admin_name || 'System Officer' %></div>
                    <div class="text-[11px] text-slate-400"><%= log.admin_email || '' %></div>
                  </td>
                  <td class="py-3.5 px-6 font-medium text-slate-800"><%= log.action_description || log.action %></td>
                  <td class="py-3.5 px-6 font-mono text-slate-500"><%= log.ip_address || '127.0.0.1' %></td>
                  <td class="py-3.5 px-6 text-right text-slate-500">
                    <%= typeof timeAgo === 'function' ? timeAgo(log.timestamp) : new Date(log.timestamp).toLocaleString() %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script>
    (function() {
      const searchInput = document.getElementById('auditSearchInput');
      if (!searchInput) return;
      searchInput.addEventListener('input', () => {
        const q = searchInput.value.toLowerCase().trim();
        document.querySelectorAll('.audit-row').forEach(row => {
          row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
      });
    })();
  </script>
</body>
</html>
