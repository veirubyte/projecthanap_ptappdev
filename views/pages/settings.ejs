                      </div>
                    </div>

                    <!-- CRUD Action Buttons -->
                    <div class="flex items-center gap-2 shrink-0">
                      <a href="/items/<%= item.id %>" class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition" title="View details">
                        View
                      </a>
                      <% if (canEditOwnedItem) { %>
                        <a href="/items/<%= item.id %>/edit" class="px-3 py-1.5 rounded-lg bg-sky-50 hover:bg-sky-100 text-sky-800 border border-sky-200 text-xs font-semibold transition" title="Edit report">
                          Edit
                        </a>
                      <% } %>
                      <form action="/items/<%= item.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this report?');" class="inline">
                        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                        <% } %>
                        <button type="submit" class="px-2.5 py-1.5 rounded-lg text-rose-600 hover:bg-rose-50 text-xs font-semibold transition cursor-pointer" title="Delete report">
                          <span class="material-symbols-outlined text-[16px]">delete</span>
                        </button>
                      </form>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>

          <!-- ================= PANEL 4: ACTIVITY LOG ================= -->
          <div id="panel-activity" class="settings-panel rounded-3xl p-6 sm:p-8 bg-white/90 backdrop-blur-xl border border-white/90 shadow-[0_8px_30px_rgba(15,23,42,0.04)] flex flex-col gap-6 hidden">
            <div class="border-b border-slate-100 pb-4">
              <h2 class="text-lg font-bold text-slate-900">Activity Log</h2>
              <p class="text-xs text-slate-500">Chronological history of your reported items, claims, and security audit events.</p>
            </div>

            <div class="space-y-4">
              <!-- Account Created -->
              <div class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50/70 border border-slate-100">
                <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center shrink-0 mt-0.5">
                  <span class="material-symbols-outlined text-[18px]">verified_user</span>
                </div>
                <div class="flex flex-col">
                  <span class="text-xs font-bold text-slate-800">Account Registered</span>
                  <span class="text-xs text-slate-500">Joined Project HANAP with institutional email <%= profileUser.email %>.</span>
                  <span class="text-[10px] text-slate-400 mt-0.5"><%= new Date(profileUser.created_at).toLocaleString() %></span>
                </div>
              </div>

              <!-- Reports Log Loop -->
              <% if (myReports && myReports.length > 0) { %>
                <% myReports.slice(0, 5).forEach(r => { %>
                  <div class="flex items-start gap-3 p-3 rounded-2xl bg-white/80 border border-slate-200/60">
                    <div class="w-8 h-8 rounded-full bg-sky-100 text-[#09436B] flex items-center justify-center shrink-0 mt-0.5">
                      <span class="material-symbols-outlined text-[18px]">post_add</span>
                    </div>
                    <div class="flex flex-col">
                      <span class="text-xs font-bold text-slate-800">Report Filed: "<%= r.item_name %>"</span>
                      <span class="text-xs text-slate-500">Type: <%= r.report_type.toUpperCase() %> • Location: <%= r.location_found_lost %> • Status: <%= r.status %></span>
                      <span class="text-[10px] text-slate-400 mt-0.5"><%= new Date(r.date_reported).toLocaleString() %></span>
                    </div>
                  </div>
                <% }) %>
              <% } %>

              <!-- Claims Log Loop -->
              <% if (claimsMade && claimsMade.length > 0) { %>
                <% claimsMade.forEach(c => { %>
                  <div class="flex items-start gap-3 p-3 rounded-2xl bg-white/80 border border-slate-200/60">
                    <div class="w-8 h-8 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center shrink-0 mt-0.5">
                      <span class="material-symbols-outlined text-[18px]">handshake</span>
                    </div>
                    <div class="flex flex-col">
                      <span class="text-xs font-bold text-slate-800">Claim Submitted for "<%= c.item_name %>"</span>
                      <span class="text-xs text-slate-500">Finder: <%= c.reporter_name %> • Status: <%= c.status.toUpperCase() %></span>
                      <span class="text-[10px] text-slate-400 mt-0.5"><%= new Date(c.created_at).toLocaleString() %></span>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>

          <!-- ================= PANEL 5: NOTIFICATION DETAILS ================= -->
          <div id="panel-notifications" class="settings-panel rounded-3xl p-6 sm:p-8 bg-white/90 backdrop-blur-xl border border-white/90 shadow-[0_8px_30px_rgba(15,23,42,0.04)] flex flex-col gap-6 hidden">
            <div class="border-b border-slate-100 pb-4">
              <h2 class="text-lg font-bold text-slate-900">Notification Details</h2>
              <p class="text-xs text-slate-500">Customize how and when Project HANAP sends you alerts and claim notifications.</p>
            </div>

            <form action="/settings/notifications" method="POST" class="flex flex-col gap-4">
              <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
              <% } %>

              <div class="p-4 rounded-2xl bg-white/80 border border-slate-200/70 flex items-center justify-between gap-3">
                <div class="flex items-start gap-3">
                  <span class="material-symbols-outlined text-primary text-[22px] mt-0.5">mark_email_read</span>
                  <div>
                    <span class="text-xs sm:text-sm font-bold text-slate-800 block">Claim Alerts</span>
                    <span class="text-[11px] text-slate-500">Receive an email immediately when another student files a claim on an item you reported.</span>
                  </div>
                </div>
                <input checked class="w-5 h-5 text-[#2B5B84] rounded-md focus:ring-sky-500 accent-[#2B5B84] cursor-pointer" type="checkbox" name="notify_claims"/>
              </div>

              <div class="p-4 rounded-2xl bg-white/80 border border-slate-200/70 flex items-center justify-between gap-3">
