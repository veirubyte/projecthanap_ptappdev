  </main>

  <!-- Footer -->
  <footer class="w-full border-t border-white/60 bg-white/50 backdrop-blur-md py-4 mt-8">
    <div class="max-w-[1060px] mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-400 font-medium">
      <div class="flex items-center gap-2">
        <span class="font-bold text-slate-700">Project HANAP</span>
        <span>•</span>
        <span>CSPC Camarines Sur</span>
      </div>
      <div>© 2026 CSPC Campus Care Network</div>
    </div>
  </footer>

  <script>
    // Tab Switching Logic
    (function() {
      const tabButtons = document.querySelectorAll('.tab-btn');
      const panels = document.querySelectorAll('.settings-panel');

      function switchTab(tabName) {
        panels.forEach(p => p.classList.add('hidden'));
        const activePanel = document.getElementById(`panel-${tabName}`);
        if (activePanel) activePanel.classList.remove('hidden');

        tabButtons.forEach(btn => {
          if (btn.getAttribute('data-tab') === tabName) {
            btn.className = 'tab-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all bg-[#09436B] text-white shadow-xs cursor-pointer text-left';
          } else {
            btn.className = 'tab-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 cursor-pointer text-left';
          }
        });

        history.replaceState(null, null, `#${tabName}`);
      }

      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const tab = btn.getAttribute('data-tab');
          switchTab(tab);
        });
      });

      // Handle Hash on load
      const hash = window.location.hash.replace('#', '');
      if (hash && document.getElementById(`panel-${hash}`)) {
        switchTab(hash);
      }
    })();

    (function() {
      const passwordForm = document.querySelector('form[action="/settings/security"]');
      const newPasswordInput = document.getElementById('newPassword');
      const confirmPasswordInput = document.getElementById('confirmPassword');
      const strengthText = document.getElementById('settingsPasswordStrengthText');
      const strengthMeter = document.getElementById('settingsPasswordStrengthMeter');
      const warning = document.getElementById('settingsPasswordWarning');

      if (!passwordForm || !newPasswordInput || !confirmPasswordInput || !strengthText || !strengthMeter || !warning) return;

      const bars = Array.from(strengthMeter.children);
      const calculateStrength = (password) => {
        const hasLength = password.length >= 8;
        const hasUpper = /[A-Z]/.test(password);
        const hasLower = /[a-z]/.test(password);
        const hasNumber = /[0-9]/.test(password);
        const hasSpecial = /[!@#$%^&*(),.?":{}|<>_\-+=\[\]\\\/`~]/.test(password);

        if (hasLength && hasUpper && hasLower && hasNumber && hasSpecial) return 3;
        if (hasLength && hasUpper && hasLower && hasNumber) return 2;
        if (hasLength) return 1;
        return 0;
      };

      const updateStrengthMeter = () => {
        const password = newPasswordInput.value;
        const strength = calculateStrength(password);
        const labels = [
          password ? 'Password Strength: Too Short (< 8 chars)' : 'Password Strength: Empty',
          'Password Strength: Weak (Need Upper, Lower & Number)',
          'Password Strength: Medium (Need Special Character)',
          'Password Strength: Strong (All Requirements Met)'
        ];

        strengthMeter.setAttribute('aria-valuenow', String(strength));
        strengthText.textContent = labels[strength];
        strengthText.className = strength === 3
          ? 'font-semibold text-emerald-700'
          : (strength > 0 ? 'font-semibold text-blue-700' : 'font-semibold text-slate-500');

        bars.forEach((bar, index) => {
          bar.className = `h-full rounded-full transition-colors duration-300 ${index < strength ? 'bg-[#2B5B84]' : 'bg-slate-200'}`;
        });

        if (strength === 3) {
          warning.classList.add('hidden');
          warning.textContent = '';
          newPasswordInput.classList.remove('border-rose-500', 'ring-2', 'ring-rose-200');
        }
      };

      newPasswordInput.addEventListener('input', updateStrengthMeter);

      passwordForm.addEventListener('submit', (event) => {
        const strength = calculateStrength(newPasswordInput.value);
        if (strength < 3) {
          event.preventDefault();
          warning.textContent = 'Password rejected. Use at least 8 characters with an uppercase letter, a lowercase letter, a number, and a special character.';
          warning.classList.remove('hidden');
          newPasswordInput.classList.add('border-rose-500', 'ring-2', 'ring-rose-200');
          newPasswordInput.focus();
          return;
        }

        if (newPasswordInput.value !== confirmPasswordInput.value) {
          event.preventDefault();
          warning.textContent = 'New password and confirmation password do not match.';
          warning.classList.remove('hidden');
          confirmPasswordInput.classList.add('border-rose-500', 'ring-2', 'ring-rose-200');
          confirmPasswordInput.focus();
          return;
        }

        warning.classList.add('hidden');
        warning.textContent = '';
      });

      confirmPasswordInput.addEventListener('input', () => {
        confirmPasswordInput.classList.remove('border-rose-500', 'ring-2', 'ring-rose-200');
        if (newPasswordInput.value === confirmPasswordInput.value) {
          warning.classList.add('hidden');
          warning.textContent = '';
        }
      });
    })();

    document.querySelectorAll('[data-password-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const input = document.getElementById(button.dataset.passwordToggle);
        if (!input) return;

        const shouldShow = input.type === 'password';
        input.type = shouldShow ? 'text' : 'password';
        button.setAttribute('aria-pressed', String(shouldShow));
        button.setAttribute('aria-label', `${shouldShow ? 'Hide' : 'Show'} ${input.labels?.[0]?.textContent.trim().toLowerCase() || 'password'}`);
        button.querySelector('span').textContent = shouldShow ? 'visibility_off' : 'visibility';
      });
    });

    document.querySelectorAll('input[name="themePreference"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        if (radio.checked && typeof window.setHanapTheme === 'function') {
          window.setHanapTheme(radio.value);
        }
      });
    });
  </script>
</body>
</html>
