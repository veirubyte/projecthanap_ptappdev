          <!-- ================= PANEL 6: NIGHT MODE SETTINGS ================= -->
          <div id="panel-darkmode" class="settings-panel rounded-3xl p-6 sm:p-8 bg-white/90 backdrop-blur-xl border border-white/90 shadow-[0_8px_30px_rgba(15,23,42,0.04)] flex flex-col gap-6 hidden">
            <div class="border-b border-slate-100 pb-4">
              <h2 class="text-lg font-bold text-slate-900">Night Mode / Theme Settings</h2>
              <p class="text-xs text-slate-500">Toggle between Light Horizon and Serene Deep Slate Night Mode.</p>
