              </div>

              <div class="p-4 rounded-2xl bg-white/80 border border-slate-200/70 flex items-center justify-between gap-3">
                <div class="flex items-start gap-3">
                  <span class="material-symbols-outlined text-primary text-[22px] mt-0.5">campaign</span>
                  <div>
                    <span class="text-xs sm:text-sm font-bold text-slate-800 block">Campus Care Broadcasts</span>
                    <span class="text-[11px] text-slate-500">Receive campus-wide notifications for high-priority lost valuables (IDs, keys, laptops).</span>
                  </div>
                </div>
                <input checked class="w-5 h-5 text-[#2B5B84] rounded-md focus:ring-sky-500 accent-[#2B5B84] cursor-pointer" type="checkbox" name="notify_broadcasts"/>
              </div>

              <div class="flex items-center justify-end pt-2">
                <button type="submit" class="px-6 h-11 rounded-xl bg-gradient-to-r from-[#09436B] to-[#2B5B84] hover:brightness-110 text-white font-bold text-xs sm:text-sm flex items-center gap-2 shadow-sm transition-all cursor-pointer">
