                            <%= item.report_type %>
                          </span>
                          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= (item.status === 'claimed' || item.status === 'returned') ? 'bg-emerald-100 text-emerald-800' : (item.status === 'pending_review' ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800') %>">
                            <%= item.status %>
