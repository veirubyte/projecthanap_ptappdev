            <fieldset class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <legend class="sr-only">Choose appearance</legend>
              <label class="flex items-start gap-3 p-5 rounded-2xl border border-slate-200/80 bg-white/80 cursor-pointer hover:border-[#2B5B84] transition-colors">
                <input type="radio" name="themePreference" value="light" class="mt-1 accent-[#2B5B84]"/>
                <span class="flex flex-col gap-2">
                  <span class="flex items-center gap-2 text-xs font-bold text-slate-800">
                    <span class="w-3 h-3 rounded-full bg-slate-100 border border-slate-300"></span>
                    Light Horizon
                  </span>
                  <span class="text-xs text-slate-500">Daylight theme with a cool alabaster canvas and crisp glass panels.</span>
                </span>
              </label>
              <label class="flex items-start gap-3 p-5 rounded-2xl border border-slate-700 bg-[#0E162D] text-white cursor-pointer hover:border-sky-400 transition-colors">
                <input type="radio" name="themePreference" value="dark" class="mt-1 accent-sky-400"/>
                <span class="flex flex-col gap-2">
                  <span class="flex items-center gap-2 text-xs font-bold text-white">
                    <span class="w-3 h-3 rounded-full bg-[#38BDF8]"></span>
                    Serene Horizon Night Mode
                  </span>
                  <span class="text-xs text-slate-300">Low-glare midnight navy canvas with glowing frosted glass cards.</span>
                </span>
