<%- include('../partials/header') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header bg-primary text-white text-center py-4">
          <div class="brand-icon bg-white text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow-xs" style="width: 48px; height: 48px;">
            <i class="bi bi-shield-lock fs-4"></i>
          </div>
          <h4 class="fw-bold mb-1">Campus Portal Sign In</h4>
          <p class="fs-xs text-white-80 mb-0">Project HANAP Authentication Gateway</p>
        </div>
        <div class="card-body p-4 p-md-5">
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 fs-sm" role="alert">
              <i class="bi bi-exclamation-triangle-fill"></i>
              <div><%= error %></div>
              <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 fs-sm" role="alert">
              <i class="bi bi-check-circle-fill"></i>
              <div><%= success %></div>
              <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <form action="/auth/login" method="POST" novalidate>
            <div class="mb-3">
              <label for="email" class="form-label fw-semibold fs-sm">Campus Email Address</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                <input type="email" class="form-control border-start-0" id="email" name="email" placeholder="e.g. student@hanap.campus.edu" required autofocus>
              </div>
            </div>

            <div class="mb-4">
              <div class="d-flex justify-content-between align-items-center">
                <label for="password" class="form-label fw-semibold fs-sm mb-0">Password</label>
              </div>
              <div class="input-group mt-1">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                <input type="password" class="form-control border-start-0" id="password" name="password" placeholder="••••••••" required>
              </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm mb-3">
              <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Account
            </button>
          </form>

          <!-- Pre-configured test accounts helper for quick instructor evaluation -->
          <div class="p-3 bg-light rounded-3 border">
            <small class="fw-bold d-block text-secondary text-uppercase tracking-wider fs-xs mb-2">
              <i class="bi bi-info-circle me-1"></i> Evaluation Test Credentials:
            </small>
            <ul class="list-unstyled mb-0 fs-xs text-muted">
              <li class="mb-1"><strong>Admin:</strong> <code>admin@hanap.campus.edu</code> | <code>AdminPass123!</code></li>
              <li class="mb-1"><strong>Staff:</strong> <code>staff@hanap.campus.edu</code> | <code>StaffPass123!</code></li>
              <li><strong>Student:</strong> <code>student@hanap.campus.edu</code> | <code>StudentPass123!</code></li>
            </ul>
          </div>
        </div>
        <div class="card-footer bg-light text-center py-3 border-0">
          <small class="text-muted">Don't have an account yet? <a href="/auth/register" class="fw-semibold text-primary">Register here</a></small>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
