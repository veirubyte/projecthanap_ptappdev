<%- include('../partials/header') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 text-center">
      <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5">
        <div class="mb-3">
          <span class="badge <%= (typeof statusCode !== 'undefined' && statusCode === 403) ? 'bg-danger' : (typeof statusCode !== 'undefined' && statusCode === 404 ? 'bg-warning text-dark' : 'bg-danger') %> px-3 py-2 rounded-pill fs-6 fw-bold">
            Status <%= typeof statusCode !== 'undefined' ? statusCode : 500 %>
          </span>
        </div>
        <h2 class="fw-bold mb-2"><%= typeof title !== 'undefined' ? title : 'System Notice' %></h2>
        <p class="text-muted mb-4 fs-sm">
          <%= typeof errorMessage !== 'undefined' ? errorMessage : 'An error was encountered while processing your request.' %>
        </p>

        <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
          <div class="alert alert-warning text-start mb-4 fs-xs">
            <div class="fw-bold mb-1">Please address the following items:</div>
            <ul class="mb-0 ps-3">
              <% errors.forEach(function(err) { %>
                <li><%= err %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>

        <div class="d-flex justify-content-center gap-2">
          <a href="/" class="btn btn-primary px-4 fw-semibold">
            <i class="bi bi-house-door me-1"></i> Return to Dashboard
          </a>
          <button onclick="window.history.back()" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-left me-1"></i> Go Back
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
