<%- include('../partials/header') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border shadow-sm rounded-3 p-4 p-md-5 bg-white text-center">
        <div class="mb-3">
          <span class="badge bg-primary text-uppercase px-3 py-2 rounded-pill fs-xs">
            Starter Baseline Scaffold
          </span>
        </div>
        <h1 class="display-6 fw-bold mb-3 text-dark">
          Project <span class="text-primary">HANAP</span>
        </h1>
        <p class="lead text-muted mb-4">
          Campus System &bull; Round 1 Starter Template
        </p>
        
        <div class="alert alert-secondary text-start p-3 rounded-2 mb-4 fs-sm">
          <div class="fw-bold mb-1">
            <i class="bi bi-info-circle me-1"></i> Developer Notice:
          </div>
          <p class="mb-2 text-muted">
            This repository contains the baseline MVC scaffolding and configuration. UI pages, forms, and business features are ready to be implemented by team members on their assigned feature branches:
          </p>
          <ul class="mb-0 text-muted ps-3">
            <li><strong>Member 1:</strong> Express routes, business controllers, and server-side validation.</li>
            <li><strong>Member 2:</strong> EJS views, partials, forms, layout design, and styling.</li>
            <li><strong>Member 3:</strong> Database schemas, connection pooling, bcrypt hashing, and authentication.</li>
          </ul>
        </div>

        <div class="text-muted fs-xs">
          Server running on port <%= typeof process !== 'undefined' && process.env.PORT ? process.env.PORT : '3000' %> &bull; MVC Architecture Ready
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
