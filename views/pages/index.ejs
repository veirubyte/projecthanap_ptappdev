<%- include('../partials/header') %>

<div class="hero-section py-5 bg-gradient-primary text-white shadow-sm mb-4">
  <div class="container">
    <div class="row align-items-center gy-4">
      <div class="col-lg-7">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold text-uppercase tracking-wider fs-xs mb-3 shadow-xs">
          <i class="bi bi-shield-check me-1"></i> Midterm Project &bull; Round 1 Starter Baseline
        </span>
        <h1 class="display-5 fw-extrabold mb-3 tracking-tight">
          Project <span class="text-warning">HANAP</span> Campus System
        </h1>
        <p class="lead mb-4 text-white-80">
          A centralized, role-based item recovery, lost-and-found registry, and campus property tracking portal designed for seamless student, faculty, and administrative collaboration.
        </p>
        <div class="d-flex flex-wrap gap-2">
          <% if (currentUser) { %>
            <a href="#browse-catalog" class="btn btn-warning btn-lg fw-bold px-4 text-dark shadow-sm">
              <i class="bi bi-search me-1"></i> Browse Catalog
            </a>
            <a href="#quick-report" class="btn btn-outline-light btn-lg fw-medium px-4">
              <i class="bi bi-plus-circle me-1"></i> Report Item
            </a>
          <% } else { %>
            <a href="/auth/login" class="btn btn-warning btn-lg fw-bold px-4 text-dark shadow-sm">
              <i class="bi bi-box-arrow-in-right me-1"></i> Access System
            </a>
            <a href="/auth/register" class="btn btn-outline-light btn-lg fw-medium px-4">
              <i class="bi bi-person-plus me-1"></i> Create Student/Staff Account
            </a>
          <% } %>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="card bg-white text-dark shadow-lg border-0 rounded-4 p-3 backdrop-blur">
          <div class="card-body">
            <h5 class="fw-bold mb-3 d-flex align-items-center justify-content-between">
              <span><i class="bi bi-activity text-primary me-2"></i>Campus Registry Pulse</span>
              <span class="badge bg-success-subtle text-success border border-success-subtle fs-xs">Live System</span>
            </h5>
            <div class="row g-2 text-center">
              <div class="col-6">
                <div class="p-3 rounded-3 bg-light border">
                  <div class="fs-3 fw-bold text-danger"><%= stats.reportedLost %></div>
                  <small class="text-muted fw-semibold">Reported Lost</small>
                </div>
              </div>
              <div class="col-6">
                <div class="p-3 rounded-3 bg-light border">
                  <div class="fs-3 fw-bold text-primary"><%= stats.reportedFound %></div>
                  <small class="text-muted fw-semibold">Turned-In Items</small>
                </div>
              </div>
              <div class="col-6">
                <div class="p-3 rounded-3 bg-light border">
                  <div class="fs-3 fw-bold text-success"><%= stats.reunited %></div>
                  <small class="text-muted fw-semibold">Successfully Reunited</small>
                </div>
              </div>
              <div class="col-6">
                <div class="p-3 rounded-3 bg-light border">
                  <div class="fs-3 fw-bold text-warning"><%= stats.activeOffices %></div>
                  <small class="text-muted fw-semibold">Custody Stations</small>
                </div>
              </div>
            </div>
            <% if (currentUser) { %>
              <div class="alert alert-primary mt-3 mb-0 py-2 fs-xs d-flex align-items-center gap-2">
                <i class="bi bi-person-check-fill fs-6"></i>
                <div>Logged in as: <strong><%= currentUser.name %></strong> (<%= currentUser.role %>)</div>
              </div>
            <% } else { %>
              <div class="alert alert-secondary mt-3 mb-0 py-2 fs-xs text-muted">
                <i class="bi bi-info-circle me-1"></i> Sign in with test credentials to test RBAC restrictions.
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container my-5">
  <!-- Team Collaboration Architecture Overview -->
  <div class="row mb-5 g-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm rounded-4 p-4">
        <h4 class="fw-bold mb-3 d-flex align-items-center gap-2 text-dark">
          <i class="bi bi-people-fill text-primary"></i> Team Responsibilities & Branch Workflows
        </h4>
        <p class="text-muted mb-4">
          The Project HANAP codebase is cleanly divided into modular layers allowing all 3 team members to branch from <code>main</code> simultaneously without merge friction.
        </p>
        <div class="row g-3">
          <div class="col-md-4">
            <div class="p-3 rounded-3 border-start border-primary border-4 bg-light h-100">
              <span class="badge bg-primary mb-2">Member 1</span>
              <h6 class="fw-bold text-dark">Backend & Routing Architect</h6>
              <p class="fs-sm text-muted mb-2">
                Responsible for Express routes, business controllers, validation middleware, and API endpoints.
              </p>
              <code class="fs-xs text-primary">branch: feature/backend-routes</code>
            </div>
          </div>
          <div class="col-md-4">
            <div class="p-3 rounded-3 border-start border-warning border-4 bg-light h-100">
              <span class="badge bg-warning text-dark mb-2">Member 2</span>
              <h6 class="fw-bold text-dark">Frontend & UI/UX Specialist</h6>
              <p class="fs-sm text-muted mb-2">
                Responsible for EJS views, partials, responsive layouts, forms, user feedback alerts, and style polish.
              </p>
              <code class="fs-xs text-warning">branch: feature/frontend-pages</code>
            </div>
          </div>
          <div class="col-md-4">
            <div class="p-3 rounded-3 border-start border-success border-4 bg-light h-100">
              <span class="badge bg-success mb-2">Member 3</span>
              <h6 class="fw-bold text-dark">Database, Auth & Security</h6>
              <p class="fs-sm text-muted mb-2">
                Responsible for MySQL connection pooling, bcrypt hashing, session auth, RBAC middleware, and test suites.
              </p>
              <code class="fs-xs text-success">branch: feature/database-auth</code>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Item Catalog Section -->
  <div class="row g-4" id="browse-catalog">
    <div class="col-12">
      <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <div>
          <h4 class="fw-bold text-dark mb-1">
            <i class="bi bi-collection text-primary me-2"></i>Recent Campus Records
          </h4>
          <p class="text-muted fs-sm mb-0">Browse latest missing and recovered items across campus buildings.</p>
        </div>
        <div class="d-flex gap-2">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" class="form-control border-start-0" placeholder="Search item, category, location...">
          </div>
          <select class="form-select form-select-sm w-auto">
            <option value="all">All Statuses</option>
            <option value="lost">Lost</option>
            <option value="found">Turned In</option>
            <option value="claimed">Claimed</option>
          </select>
        </div>
      </div>

      <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light fs-xs text-uppercase tracking-wider">
              <tr>
                <th scope="col" class="ps-4">Item Code</th>
                <th scope="col">Title & Description</th>
                <th scope="col">Category</th>
                <th scope="col">Campus Location</th>
                <th scope="col">Status</th>
                <th scope="col">Date Logged</th>
                <th scope="col" class="text-end pe-4">Action</th>
              </tr>
            </tr>
            <tbody class="fs-sm">
              <tr>
                <td class="ps-4 fw-mono fw-bold text-primary">#HNP-2026-001</td>
                <td>
                  <div class="fw-semibold">Blue HydroFlask Bottle</div>
                  <small class="text-muted">32oz stainless steel with college sticker</small>
                </td>
                <td><span class="badge bg-secondary-subtle text-secondary">Personal Item</span></td>
                <td>ICT Lab 304, Building A</td>
                <td><span class="badge bg-warning-subtle text-warning border border-warning-subtle">Lost</span></td>
                <td>Oct 22, 2026</td>
                <td class="text-end pe-4">
                  <button class="btn btn-outline-primary btn-sm rounded-pill px-3">View Details</button>
                </td>
              </tr>
              <tr>
                <td class="ps-4 fw-mono fw-bold text-primary">#HNP-2026-002</td>
                <td>
                  <div class="fw-semibold">Scientific Calculator (Casio fx-991EX)</div>
                  <small class="text-muted">ClassWiz model with engraved initials 'M.S.'</small>
                </td>
                <td><span class="badge bg-secondary-subtle text-secondary">Electronics</span></td>
                <td>Library 2nd Floor Study Nook</td>
                <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">Turned In</span></td>
                <td>Oct 21, 2026</td>
                <td class="text-end pe-4">
                  <button class="btn btn-outline-primary btn-sm rounded-pill px-3">Claim Item</button>
                </td>
              </tr>
              <tr>
                <td class="ps-4 fw-mono fw-bold text-primary">#HNP-2026-003</td>
                <td>
                  <div class="fw-semibold">RFID Student ID & Lanyard</div>
                  <small class="text-muted">Engineering Department lanyard with white ID card</small>
                </td>
                <td><span class="badge bg-secondary-subtle text-secondary">Documents / ID</span></td>
                <td>Main Cafeteria Booth 7</td>
                <td><span class="badge bg-success-subtle text-success border border-success-subtle">Reunited</span></td>
                <td>Oct 20, 2026</td>
                <td class="text-end pe-4">
                  <button class="btn btn-light btn-sm text-muted rounded-pill px-3" disabled>Resolved</button>
                </td>
              </tr>
              <tr>
                <td class="ps-4 fw-mono fw-bold text-primary">#HNP-2026-004</td>
                <td>
                  <div class="fw-semibold">Black Lenovo ThinkPad USB-C Charger</div>
                  <small class="text-muted">65W AC power adapter with velcro tie</small>
                </td>
                <td><span class="badge bg-secondary-subtle text-secondary">Accessories</span></td>
                <td>AVR Room 2, Ground Floor</td>
                <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">Turned In</span></td>
                <td>Oct 19, 2026</td>
                <td class="text-end pe-4">
                  <button class="btn btn-outline-primary btn-sm rounded-pill px-3">Claim Item</button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
