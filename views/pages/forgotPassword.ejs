<!DOCTYPE html>
<html class="login-page" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Password Recovery - HANAP CSPC</title>
  <%- include('partials/themeSetup') %>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#2B5B84",
            "primary-hover": "#1E40AF",
            "primary-container": "#2B5B84",
            "on-primary": "#ffffff",
            "background": "#F4F7FB",
            "on-surface": "#0F172A",
            "text-muted": "#64748B",
            "border-subtle": "#E2E8F0",
            "secondary": "#0058be"
          },
          fontFamily: {
            sans: ["Plus Jakarta Sans", "sans-serif"]
          }
        }
      }
    };
  </script>
</head>
<body class="login-page bg-[#F4F7FB] text-[#0F172A] font-sans antialiased min-h-screen relative overflow-x-hidden selection:bg-blue-500/20">
  <main class="relative w-full min-h-screen bg-[#F4F7FB] flex items-center justify-center p-4 sm:p-6 lg:p-12 overflow-hidden">
    
    <!-- Ambient Aurora Mesh Glow Behind Glass Portal -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden flex items-center justify-center" aria-hidden="true">
      <div class="absolute -top-32 -left-20 w-[500px] h-[500px] rounded-full bg-[#2B5B84]/[0.12] blur-[110px] transform-gpu"></div>
      <div class="absolute top-1/4 -right-24 w-[540px] h-[540px] rounded-full bg-[#3B82F6]/[0.10] blur-[120px] transform-gpu"></div>
      <div class="absolute -bottom-24 left-1/3 w-[460px] h-[460px] rounded-full bg-[#0D9488]/[0.08] blur-[100px] transform-gpu"></div>
    </div>

    <!-- Split Frosted Glass Card Container -->
    <div class="relative z-10 w-full max-w-[1020px] bg-white/80 backdrop-blur-xl rounded-[28px] border border-white/90 shadow-[0_24px_50px_-12px_rgba(15,23,42,0.08),0_10px_20px_-8px_rgba(43,91,132,0.05),0_0_0_1px_rgba(226,232,240,0.8)] overflow-hidden flex flex-col md:flex-row p-3.5 sm:p-4 gap-4">
      
      <!-- LEFT SHOWCASE PANEL: Sapphire-tinted glass with recovery motif & dynamic stepper -->
      <div class="md:w-[45%] w-full rounded-2xl bg-gradient-to-br from-[#EBF3FB]/90 via-[#E4EFF9]/80 to-[#D8E8F8]/70 border border-white/70 p-8 sm:p-10 flex flex-col justify-between relative overflow-hidden select-none shadow-[inset_0_1px_1px_rgba(255,255,255,0.8)]">
        <!-- Specular shimmer gradient -->
        <div class="absolute -top-20 -right-20 w-44 h-44 rounded-full bg-white/40 blur-2xl pointer-events-none"></div>
        
        <!-- Brand Header -->
        <div class="flex items-center gap-3 z-10">
          <a href="/" class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#2B5B84] to-[#1E40AF] text-white flex items-center justify-center shadow-md shadow-[#2B5B84]/25 ring-1 ring-white/40 hover:scale-105 transition-transform" title="Back to Welcome Portal">
            <span class="material-symbols-outlined text-[22px]">explore</span>
          </a>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-xl font-bold tracking-tight text-[#0F172A]">HANAP</span>
              <span class="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded-md bg-white/90 text-[#2B5B84] border border-slate-200/80 shadow-xs">CSPC</span>
            </div>
            <p class="text-[11px] font-medium text-slate-500">Nabua Campus</p>
          </div>
        </div>

        <!-- Headline & Stepper Info -->
        <div class="my-auto py-6 z-10 space-y-6">
          <div>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-[#0F172A] leading-[1.18] tracking-tight">
              Restore access to your account.
            </h1>
            <p class="text-xs text-slate-600 mt-2 leading-relaxed">
              Fast, secure self-service password recovery for students, faculty, staff, parents, and campus guests.
            </p>
          </div>

          <!-- Dynamic Recovery Stepper -->
          <div class="space-y-3 bg-white/60 backdrop-blur-md p-4 rounded-2xl border border-white/80 shadow-xs">
            <div class="flex items-center gap-3">
              <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold <%= (step === 'request') ? 'bg-[#2B5B84] text-white ring-4 ring-[#2B5B84]/20' : (step === 'verify' || step === 'reset' || step === 'success' ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-500') %>">
                <% if (step === 'verify' || step === 'reset' || step === 'success') { %>
                  <span class="material-symbols-outlined text-sm">check</span>
                <% } else { %>
                  1
                <% } %>
              </div>
              <div class="flex-1">
                <p class="text-xs font-bold text-slate-800">Identify Account</p>
                <p class="text-[10px] text-slate-500">Enter your registered email</p>
              </div>
            </div>

            <div class="h-3 w-px bg-slate-300 ml-3.5"></div>

            <div class="flex items-center gap-3">
              <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold <%= (step === 'verify') ? 'bg-[#2B5B84] text-white ring-4 ring-[#2B5B84]/20' : (step === 'reset' || step === 'success' ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-500') %>">
                <% if (step === 'reset' || step === 'success') { %>
                  <span class="material-symbols-outlined text-sm">check</span>
                <% } else { %>
                  2
                <% } %>
              </div>
              <div class="flex-1">
                <p class="text-xs font-bold text-slate-800">Verify Identity</p>
                <p class="text-[10px] text-slate-500">Enter 6-digit one-time code</p>
              </div>
            </div>

            <div class="h-3 w-px bg-slate-300 ml-3.5"></div>

            <div class="flex items-center gap-3">
              <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold <%= (step === 'reset') ? 'bg-[#2B5B84] text-white ring-4 ring-[#2B5B84]/20' : (step === 'success' ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-500') %>">
                <% if (step === 'success') { %>
                  <span class="material-symbols-outlined text-sm">check</span>
                <% } else { %>
                  3
                <% } %>
              </div>
              <div class="flex-1">
                <p class="text-xs font-bold text-slate-800">New Password</p>
                <p class="text-[10px] text-slate-500">Create strong credentials</p>
              </div>
            </div>
          </div>

          <!-- 3D Security Composition Card -->
          <div class="relative h-28 w-full flex items-center justify-center">
            <!-- Micro-Badge: 256-Bit Protection -->
            <div class="absolute -top-1 left-1 z-20 bg-white/85 backdrop-blur-md px-2.5 py-1 rounded-full border border-white shadow-xs flex items-center gap-1.5 transform -rotate-2">
              <span class="text-xs">🔒</span>
              <span class="text-[11px] font-semibold text-slate-700">256-Bit TLS</span>
            </div>
            <!-- Micro-Badge: 10-Min Expiry -->
            <div class="absolute -top-1 right-1 z-20 bg-white/85 backdrop-blur-md px-2.5 py-1 rounded-full border border-white shadow-xs flex items-center gap-1.5 transform rotate-2">
              <span class="text-xs">⚡</span>
              <span class="text-[11px] font-semibold text-slate-700">10-Min OTP</span>
            </div>
            <!-- Micro-Badge: Anti-Tamper -->
            <div class="absolute bottom-1 z-20 bg-white/85 backdrop-blur-md px-2.5 py-1 rounded-full border border-white shadow-xs flex items-center gap-1.5">
              <span class="text-xs">🛡️</span>
              <span class="text-[11px] font-semibold text-slate-700">Zero Password Exposure</span>
            </div>
            <div class="w-36 h-20 rounded-2xl bg-gradient-to-tr from-[#2B5B84]/20 to-[#3B82F6]/20 border border-white/80 shadow-inner flex items-center justify-center">
              <span class="material-symbols-outlined text-4xl text-[#2B5B84]">lock_reset</span>
            </div>
          </div>
        </div>

        <!-- Bottom Accent -->
        <div class="text-[11px] text-slate-500/80 font-medium tracking-wide flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#2B5B84]/60"></span>
          CSPC Lost &amp; Found System • Secure Authentication
        </div>
      </div>

      <!-- RIGHT FORM PANEL: Interactive Multi-Step Recovery Portal -->
      <div class="md:w-[55%] w-full bg-white/50 backdrop-blur-sm p-6 sm:p-10 flex flex-col justify-between rounded-2xl">
        <div class="space-y-5">
          
          <!-- Top Navigation Header -->
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-2xl font-bold text-[#0F172A] tracking-tight">
                <% if (step === 'verify') { %>
                  Enter Verification Code
                <% } else if (step === 'reset') { %>
                  Create New Password
                <% } else if (step === 'success') { %>
                  Password Reset Successful
                <% } else { %>
                  Account Password Recovery
                <% } %>
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">
                <% if (step === 'verify') { %>
                  Enter the six-digit code sent to your registered email address.
                <% } else if (step === 'reset') { %>
                  Your identity is confirmed. Choose a secure new password.
                <% } else if (step === 'success') { %>
                  You can now sign in to Project HANAP with your updated credentials.
                <% } else { %>
                  Self-service reset via email verification or official campus directory assistance.
                <% } %>
              </p>
            </div>

            <a href="/login" class="text-xs font-semibold text-[#2B5B84] hover:text-[#1E40AF] hover:underline flex items-center gap-1 shrink-0" title="Return to Sign In">
              <span class="material-symbols-outlined text-sm">arrow_back</span>
              <span>Back to Login</span>
            </a>
          </div>

          <!-- Alert Notifications (Errors or Info) -->
          <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="p-4 rounded-2xl bg-rose-50/90 border border-rose-200/90 text-rose-800 text-xs shadow-xs space-y-2 animate-fadeIn" role="alert">
              <div class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-rose-600 text-lg shrink-0 mt-0.5">warning</span>
                <div class="flex-1">
                  <strong class="font-bold text-rose-900 block mb-0.5 text-xs">
                    <%= typeof errorTitle !== 'undefined' && errorTitle ? errorTitle : 'Recovery Error' %>
                  </strong>
                  <div class="whitespace-pre-line text-rose-700 leading-relaxed font-medium">
                    <%= errorMessage %>
                  </div>
                </div>
              </div>

              <% if (typeof action !== 'undefined' && action === 'register') { %>
                <div class="pt-1.5 pl-7">
                  <a href="/register" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-white hover:bg-rose-100/60 text-rose-900 font-bold border border-rose-300 shadow-2xs transition-all">
                    <span>Create New Account</span>
                    <span class="material-symbols-outlined text-sm">person_add</span>
                  </a>
                </div>
              <% } %>
            </div>
          <% } %>

          <% if (typeof msg !== 'undefined' && msg) { %>
            <div class="p-4 rounded-2xl bg-teal-50 border border-teal-200 text-teal-900 text-xs shadow-xs flex items-start gap-2.5" role="status">
              <span class="material-symbols-outlined text-teal-600 text-lg shrink-0 mt-0.5">check_circle</span>
              <div class="flex-1 font-medium leading-relaxed">
                <%= msg %>
              </div>
            </div>
          <% } %>

          <!-- ========================================================================= -->
          <!-- STEP 1: REQUEST PASSWORD RESET / CAMPUS HELPDESK TABS -->
          <!-- ========================================================================= -->
          <% if (step === 'request') { %>
            <!-- Segmented Mode Tabs: [ Self-Service Reset ] [ Institutional Helpdesk ] -->
            <div class="inline-flex p-1 bg-slate-100/90 backdrop-blur-md rounded-2xl border border-slate-200/70 shadow-inner w-full" role="tablist">
              <button 
                type="button" 
                id="tabSelfService" 
                onclick="switchRecoveryTab('self_service')" 
                class="flex-1 py-2 px-3 text-xs font-bold rounded-xl transition-all cursor-pointer <%= (tab !== 'institutional_info') ? 'bg-white text-[#2B5B84] shadow-sm' : 'text-slate-500 hover:text-slate-800' %>">
                Self-Service Reset
              </button>
              <button 
                type="button" 
                id="tabInstitutional" 
                onclick="switchRecoveryTab('institutional_info')" 
                class="flex-1 py-2 px-3 text-xs font-bold rounded-xl transition-all cursor-pointer <%= (tab === 'institutional_info') ? 'bg-white text-[#2B5B84] shadow-sm' : 'text-slate-500 hover:text-slate-800' %>">
                Institutional Helpdesk
              </button>
            </div>

            <!-- TAB CONTENT 1: SELF SERVICE REQUEST FORM -->
            <div id="contentSelfService" class="<%= (tab === 'institutional_info') ? 'hidden' : 'space-y-4' %>">
              <form action="/forgot-password/request" method="POST" class="space-y-4" id="requestForm" novalidate>
                <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                <% } %>
                <input type="hidden" name="category" id="requestCategoryInput" value="<%= category || 'institution' %>"/>

                <!-- Category Sub-Toggle: Institution vs Guest -->
                <div class="flex items-center justify-between pb-1">
                  <span class="text-xs font-semibold text-slate-700">Account Type:</span>
                  <div class="inline-flex p-0.5 bg-slate-100 rounded-lg border border-slate-200">
                    <button 
                      type="button" 
                      id="catBtnInstitution" 
                      onclick="setRequestCategory('institution')" 
                      class="px-2.5 py-1 text-[11px] font-bold rounded-md transition-all cursor-pointer <%= (category !== 'guest') ? 'bg-white text-[#2B5B84] shadow-xs' : 'text-slate-500 hover:text-slate-800' %>">
                      Institution (@cspc)
                    </button>
                    <button 
                      type="button" 
                      id="catBtnGuest" 
                      onclick="setRequestCategory('guest')" 
                      class="px-2.5 py-1 text-[11px] font-bold rounded-md transition-all cursor-pointer <%= (category === 'guest') ? 'bg-white text-[#2B5B84] shadow-xs' : 'text-slate-500 hover:text-slate-800' %>">
                      Guest / Parent
                    </button>
                  </div>
                </div>

                <!-- Email Input with Floating Label -->
                <div class="relative">
                  <input 
                    class="peer w-full h-12 pt-4 pb-1 px-4 bg-white/80 border rounded-xl text-sm text-[#0F172A] placeholder-transparent shadow-xs focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#3B82F6]/40 focus:border-[#3B82F6] transition-all <%= (typeof invalidFields !== 'undefined' && invalidFields.includes('email')) ? 'border-rose-500 ring-2 ring-rose-200' : 'border-slate-200/80' %>" 
                    id="recoveryEmail" 
                    name="email" 
                    placeholder="name@my.cspc.edu.ph" 
                    type="email" 
                    autocomplete="email"
                    value="<%= typeof email !== 'undefined' ? email : '' %>"
                    required
                  />
                  <label 
                    class="absolute left-4 top-1.5 text-[11px] font-semibold text-slate-500 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:top-3 peer-placeholder-shown:font-normal peer-focus:top-1.5 peer-focus:text-[11px] peer-focus:font-semibold peer-focus:text-[#2B5B84] pointer-events-none" 
                    for="recoveryEmail" 
                    id="recoveryEmailLabel">
                    <%= (category === 'guest') ? 'Registered Personal Email' : 'CSPC Institutional Email' %>
                  </label>
                </div>

                <div class="p-3.5 rounded-xl bg-blue-50/70 border border-blue-100/90 text-xs text-[#09436B] leading-relaxed flex items-start gap-2">
                  <span class="material-symbols-outlined text-base text-[#2B5B84] shrink-0 mt-0.5">info</span>
                  <span>We will verify your email against active campus records and send a 6-digit confirmation code.</span>
                </div>

                <button 
                  type="submit" 
                  class="w-full h-12 bg-gradient-to-r from-[#2B5B84] to-[#1E40AF] hover:from-[#244c70] hover:to-[#1a3899] active:scale-[0.99] text-white rounded-xl text-sm font-semibold flex items-center justify-center gap-2 shadow-[0_8px_20px_-4px_rgba(43,91,132,0.4)] hover:shadow-[0_10px_24px_-4px_rgba(30,64,175,0.45)] ring-1 ring-white/20 transition-all text-center relative overflow-hidden group cursor-pointer">
                  <span>Send Recovery Code</span>
                  <span class="material-symbols-outlined text-base transition-transform group-hover:translate-x-0.5">mail</span>
                </button>
              </form>
            </div>

            <!-- TAB CONTENT 2: INSTITUTIONAL HELPDESK GUIDANCE -->
            <div id="contentInstitutional" class="<%= (tab !== 'institutional_info') ? 'hidden' : 'space-y-4' %>">
              <div class="space-y-3">
                <!-- Card 1: MIS / ICT Office -->
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
                  <div class="flex items-center gap-2 text-[#09436B]">
                    <span class="material-symbols-outlined text-lg">school</span>
                    <h3 class="text-xs font-bold uppercase tracking-wider">CSPC MIS / ICT Office</h3>
                  </div>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    For official <strong>@cspc.edu.ph</strong> and <strong>@my.cspc.edu.ph</strong> Google Workspace portal accounts or university system lockouts:
                  </p>
                  <ul class="text-xs text-slate-700 space-y-1.5 pt-1 pl-1">
                    <li class="flex items-center gap-2">
                      <span class="material-symbols-outlined text-sm text-[#2B5B84]">pin_drop</span>
                      <span><strong>Location:</strong> ICT Building, 2nd Floor, Main Campus</span>
                    </li>
                    <li class="flex items-center gap-2">
                      <span class="material-symbols-outlined text-sm text-[#2B5B84]">schedule</span>
                      <span><strong>Office Hours:</strong> Mon &ndash; Fri, 8:00 AM &ndash; 5:00 PM</span>
                    </li>
                    <li class="flex items-center gap-2">
                      <span class="material-symbols-outlined text-sm text-[#2B5B84]">mail</span>
                      <span><strong>Email:</strong> <a href="mailto:ict@cspc.edu.ph" class="text-[#2B5B84] hover:underline font-medium">ict@cspc.edu.ph</a></span>
                    </li>
                  </ul>
                  <div class="pt-2 border-t border-slate-200/70 text-[11px] text-slate-500">
                    &bull; Bring your active CSPC Student ID or Faculty/Employee ID for verification.
                  </div>
                </div>

                <!-- Card 2: Campus Security & Lost and Found Helpdesk -->
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
                  <div class="flex items-center gap-2 text-[#09436B]">
                    <span class="material-symbols-outlined text-lg">supervised_user_circle</span>
                    <h3 class="text-xs font-bold uppercase tracking-wider">Parent &amp; Guest Desk</h3>
                  </div>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    If you registered as a parent, guardian, or campus visitor without email access:
                  </p>
                  <ul class="text-xs text-slate-700 space-y-1.5 pt-1 pl-1">
                    <li class="flex items-center gap-2">
                      <span class="material-symbols-outlined text-sm text-[#2B5B84]">desk</span>
                      <span><strong>Location:</strong> Lost &amp; Found Office, Student Center Ground Floor</span>
                    </li>
                    <li class="flex items-center gap-2">
                      <span class="material-symbols-outlined text-sm text-[#2B5B84]">badge</span>
                      <span><strong>Requirement:</strong> Valid Government ID or Visitor Campus Pass</span>
                    </li>
                  </ul>
                </div>

                <button 
                  type="button" 
                  onclick="switchRecoveryTab('self_service')" 
                  class="w-full py-2.5 rounded-xl text-xs font-bold text-[#2B5B84] bg-white hover:bg-slate-100 border border-slate-200 shadow-2xs transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                  <span class="material-symbols-outlined text-base">lock_reset</span>
                  <span>Use Self-Service Email Recovery Instead</span>
                </button>
              </div>
            </div>
          <% } %>

          <!-- ========================================================================= -->
          <!-- STEP 2: VERIFICATION CODE FORM -->
          <!-- ========================================================================= -->
          <% if (step === 'verify') { %>
            <div class="space-y-4">
              <div class="p-4 rounded-2xl bg-blue-50/70 border border-blue-100 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <span class="material-symbols-outlined text-[#2B5B84] text-xl">mark_email_read</span>
                  <div>
                    <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Code sent to</p>
                    <p class="text-xs font-bold text-slate-900"><%= maskedEmail || email %></p>
                  </div>
                </div>
                <a href="/forgot-password?reset=1" class="text-xs font-bold text-[#2B5B84] hover:underline" title="Change email address">
                  Change
                </a>
              </div>

              <form action="/forgot-password/verify" method="POST" class="space-y-4" id="verifyForm">
                <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                <% } %>

                <div>
                  <label for="recoveryCode" class="block text-xs font-bold text-slate-700 mb-1.5">
                    Six-digit Verification Code
                  </label>
                  <input 
                    class="w-full h-14 rounded-xl border <%= (typeof invalidFields !== 'undefined' && invalidFields.includes('code')) ? 'border-rose-500 ring-2 ring-rose-200' : 'border-slate-300' %> text-center text-2xl tracking-[0.5em] font-bold focus:border-[#2B5B84] focus:ring-2 focus:ring-[#2B5B84]/20 transition-all" 
                    id="recoveryCode" 
                    name="code" 
                    type="text" 
                    inputmode="numeric" 
                    autocomplete="one-time-code" 
                    pattern="[0-9]{6}" 
                    maxlength="6" 
                    placeholder="000000"
                    required 
                    autofocus
                  />
                  <div class="flex items-center justify-between text-xs text-slate-500 mt-2">
                    <span><%= typeof attemptsRemaining === 'number' ? attemptsRemaining : 5 %> of 5 attempts remaining</span>
                    <span id="countdownLabel" data-cooldown="<%= typeof cooldownSeconds === 'number' ? cooldownSeconds : 0 %>"></span>
                  </div>
                </div>

                <button 
                  type="submit" 
                  class="w-full h-12 bg-gradient-to-r from-[#2B5B84] to-[#1E40AF] hover:from-[#244c70] hover:to-[#1a3899] active:scale-[0.99] text-white rounded-xl text-sm font-semibold flex items-center justify-center gap-2 shadow-[0_8px_20px_-4px_rgba(43,91,132,0.4)] ring-1 ring-white/20 transition-all cursor-pointer">
                  <span>Verify &amp; Continue</span>
                  <span class="material-symbols-outlined text-base">arrow_forward</span>
                </button>
              </form>

              <!-- Separate Resend Form -->
              <form action="/forgot-password/resend" method="POST" id="resendForm">
                <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                <% } %>
                <button 
                  type="submit" 
                  id="resendBtn" 
                  class="w-full py-2 text-xs font-bold text-[#2B5B84] hover:underline disabled:text-slate-400 disabled:no-underline transition-colors cursor-pointer">
                  Request a new verification code
                </button>
              </form>
            </div>
          <% } %>

          <!-- ========================================================================= -->
          <!-- STEP 3: CREATE NEW PASSWORD -->
          <!-- ========================================================================= -->
          <% if (step === 'reset') { %>
            <div class="space-y-4">
              <form action="/forgot-password/reset" method="POST" class="space-y-4" id="resetPasswordForm" novalidate>
                <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                <% } %>
                <input type="hidden" name="token" value="<%= resetToken %>"/>

                <!-- New Password Input -->
                <div class="relative">
                  <input 
                    class="peer w-full h-12 pt-4 pb-1 pl-4 pr-12 bg-white/80 border rounded-xl text-sm text-[#0F172A] placeholder-transparent shadow-xs focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#3B82F6]/40 focus:border-[#3B82F6] transition-all <%= (typeof invalidFields !== 'undefined' && invalidFields.includes('new_password')) ? 'border-rose-500 ring-2 ring-rose-200' : 'border-slate-200/80' %>" 
                    id="new_password" 
                    name="new_password" 
                    placeholder="New Password" 
                    type="password" 
                    autocomplete="new-password"
                    required
                  />
                  <label 
                    class="absolute left-4 top-1.5 text-[11px] font-semibold text-slate-500 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:top-3 peer-placeholder-shown:font-normal peer-focus:top-1.5 peer-focus:text-[11px] peer-focus:font-semibold peer-focus:text-[#2B5B84] pointer-events-none" 
                    for="new_password">
                    New Password
                  </label>
                  
                  <div class="absolute right-3.5 top-0 h-full flex items-center">
                    <button 
                      aria-label="Toggle password visibility" 
                      class="text-slate-400 hover:text-slate-700 transition-colors p-1 rounded-lg focus:outline-none" 
                      data-password-toggle="new_password" 
                      data-password-icon="eyeIcon1"
                      type="button">
                      <span class="material-symbols-outlined text-[19px]" id="eyeIcon1">visibility</span>
                    </button>
                  </div>
                </div>

                <!-- 3-Segment Password Strength Indicator -->
                <div class="space-y-1.5 pt-1">
                  <div class="flex items-center justify-between text-[11px]">
                    <span id="strengthText" class="font-semibold text-slate-500">Password Strength: Empty</span>
                    <span class="text-slate-400">Min 8 chars, mixed case, number &amp; symbol</span>
                  </div>
                  <div class="grid grid-cols-3 gap-1.5 h-1.5 w-full bg-slate-100 rounded-full overflow-hidden p-0.5" id="strengthMeter" role="progressbar" aria-valuemin="0" aria-valuemax="3" aria-valuenow="0">
                    <div id="bar1" class="h-full rounded-full bg-slate-200 transition-all duration-300"></div>
                    <div id="bar2" class="h-full rounded-full bg-slate-200 transition-all duration-300"></div>
                    <div id="bar3" class="h-full rounded-full bg-slate-200 transition-all duration-300"></div>
                  </div>
                </div>

                <!-- Confirm Password Input -->
                <div class="relative pt-1">
                  <input 
                    class="peer w-full h-12 pt-4 pb-1 pl-4 pr-12 bg-white/80 border rounded-xl text-sm text-[#0F172A] placeholder-transparent shadow-xs focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#3B82F6]/40 focus:border-[#3B82F6] transition-all <%= (typeof invalidFields !== 'undefined' && invalidFields.includes('confirm_password')) ? 'border-rose-500 ring-2 ring-rose-200' : 'border-slate-200/80' %>" 
                    id="confirm_password" 
                    name="confirm_password" 
                    placeholder="Confirm New Password" 
                    type="password" 
                    autocomplete="new-password"
                    required
                  />
                  <label 
                    class="absolute left-4 top-2.5 text-[11px] font-semibold text-slate-500 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:top-4 peer-placeholder-shown:font-normal peer-focus:top-2.5 peer-focus:text-[11px] peer-focus:font-semibold peer-focus:text-[#2B5B84] pointer-events-none" 
                    for="confirm_password">
                    Confirm New Password
                  </label>
                  
                  <div class="absolute right-3.5 top-1 h-12 flex items-center">
                    <button 
                      aria-label="Toggle confirm password visibility" 
                      class="text-slate-400 hover:text-slate-700 transition-colors p-1 rounded-lg focus:outline-none" 
                      data-password-toggle="confirm_password" 
                      data-password-icon="eyeIcon2"
                      type="button">
                      <span class="material-symbols-outlined text-[19px]" id="eyeIcon2">visibility</span>
                    </button>
                  </div>
                </div>

                <div id="matchNotice" class="text-[11px] font-semibold text-slate-400 hidden flex items-center gap-1">
                  <span class="material-symbols-outlined text-sm" id="matchIcon">check_circle</span>
                  <span id="matchText">Passwords match</span>
                </div>

                <button 
                  type="submit" 
                  id="submitNewPasswordBtn"
                  class="w-full h-12 bg-gradient-to-r from-[#2B5B84] to-[#1E40AF] hover:from-[#244c70] hover:to-[#1a3899] active:scale-[0.99] text-white rounded-xl text-sm font-semibold flex items-center justify-center gap-2 shadow-[0_8px_20px_-4px_rgba(43,91,132,0.4)] ring-1 ring-white/20 transition-all cursor-pointer">
                  <span>Update Password &amp; Sign In</span>
                  <span class="material-symbols-outlined text-base">check</span>
                </button>
              </form>
            </div>
          <% } %>

          <!-- ========================================================================= -->
          <!-- STEP 4: SUCCESS CONFIRMATION -->
          <!-- ========================================================================= -->
          <% if (step === 'success') { %>
            <div class="py-6 text-center space-y-5">
              <div class="w-16 h-16 rounded-3xl bg-emerald-50 text-emerald-600 border border-emerald-200/80 mx-auto flex items-center justify-center shadow-md">
                <span class="material-symbols-outlined text-3xl">task_alt</span>
              </div>
              <div class="space-y-1.5">
                <h3 class="text-xl font-bold text-slate-900">Credentials Updated Successfully</h3>
                <p class="text-xs text-slate-600 max-w-sm mx-auto leading-relaxed">
                  Your Project HANAP account password has been reset. You can now use your updated password to sign in.
                </p>
              </div>

              <div class="pt-2">
                <a 
                  href="/login" 
                  class="inline-flex w-full h-12 bg-gradient-to-r from-[#2B5B84] to-[#1E40AF] hover:from-[#244c70] hover:to-[#1a3899] text-white rounded-xl text-sm font-semibold items-center justify-center gap-2 shadow-md transition-all">
                  <span>Proceed to Sign In</span>
                  <span class="material-symbols-outlined text-base">arrow_forward</span>
                </a>
              </div>
            </div>
          <% } %>

        </div>

        <!-- Footer Navigation Links -->
        <div class="pt-8 flex items-center justify-between text-xs font-semibold text-slate-500 border-t border-slate-100/80 mt-6">
          <a class="text-[#2B5B84] hover:text-[#0058be] hover:underline transition-colors" href="/login">
            Remember your credentials? Sign In
          </a>
          <a class="text-slate-600 hover:text-[#2B5B84] flex items-center gap-1 transition-colors" href="/catalog">
            <span>Browse Catalog</span>
            <span class="material-symbols-outlined text-[14px]">arrow_outward</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <script>
    // Tab switcher between Self-Service and Institutional Support
    function switchRecoveryTab(tab) {
      const tabSelf = document.getElementById('tabSelfService');
      const tabInst = document.getElementById('tabInstitutional');
      const contentSelf = document.getElementById('contentSelfService');
      const contentInst = document.getElementById('contentInstitutional');

      if (!tabSelf || !tabInst || !contentSelf || !contentInst) return;

      if (tab === 'institutional_info') {
        tabInst.className = 'flex-1 py-2 px-3 text-xs font-bold rounded-xl transition-all cursor-pointer bg-white text-[#2B5B84] shadow-sm';
        tabSelf.className = 'flex-1 py-2 px-3 text-xs font-bold rounded-xl transition-all cursor-pointer text-slate-500 hover:text-slate-800';
        contentInst.classList.remove('hidden');
        contentSelf.classList.add('hidden');
      } else {
        tabSelf.className = 'flex-1 py-2 px-3 text-xs font-bold rounded-xl transition-all cursor-pointer bg-white text-[#2B5B84] shadow-sm';
        tabInst.className = 'flex-1 py-2 px-3 text-xs font-bold rounded-xl transition-all cursor-pointer text-slate-500 hover:text-slate-800';
        contentSelf.classList.remove('hidden');
        contentInst.classList.add('hidden');
      }
    }

    // Category selector: Institution vs Guest
    function setRequestCategory(cat) {
      const input = document.getElementById('requestCategoryInput');
      const btnInst = document.getElementById('catBtnInstitution');
      const btnGuest = document.getElementById('catBtnGuest');
      const emailLabel = document.getElementById('recoveryEmailLabel');
      const emailInput = document.getElementById('recoveryEmail');

      if (!input) return;
      input.value = cat;

      if (cat === 'guest') {
        btnGuest.className = 'px-2.5 py-1 text-[11px] font-bold rounded-md transition-all cursor-pointer bg-white text-[#2B5B84] shadow-xs';
        btnInst.className = 'px-2.5 py-1 text-[11px] font-bold rounded-md transition-all cursor-pointer text-slate-500 hover:text-slate-800';
        if (emailLabel) emailLabel.textContent = 'Registered Personal Email';
        if (emailInput) emailInput.placeholder = 'parent@gmail.com';
      } else {
        btnInst.className = 'px-2.5 py-1 text-[11px] font-bold rounded-md transition-all cursor-pointer bg-white text-[#2B5B84] shadow-xs';
        btnGuest.className = 'px-2.5 py-1 text-[11px] font-bold rounded-md transition-all cursor-pointer text-slate-500 hover:text-slate-800';
        if (emailLabel) emailLabel.textContent = 'CSPC Institutional Email';
        if (emailInput) emailInput.placeholder = 'name@my.cspc.edu.ph';
      }
    }

    // Toggle Password Visibility
    document.addEventListener('click', (event) => {
      const toggle = event.target.closest('[data-password-toggle]');
      if (!toggle) return;

      const fieldId = toggle.dataset.passwordToggle;
      const iconId = toggle.dataset.passwordIcon;
      const field = document.getElementById(fieldId);
      const icon = document.getElementById(iconId);

      if (field && icon) {
        if (field.type === 'password') {
          field.type = 'text';
          icon.textContent = 'visibility_off';
        } else {
          field.type = 'password';
          icon.textContent = 'visibility';
        }
      }
    });

    // Step 2 Countdown Timer on Resend Button
    const countdownEl = document.getElementById('countdownLabel');
    if (countdownEl) {
      const resendBtn = document.getElementById('resendBtn');
      let cooldown = parseInt(countdownEl.dataset.cooldown || '0', 10);

      function updateCountdown() {
        if (cooldown > 0) {
          if (resendBtn) resendBtn.disabled = true;
          countdownEl.textContent = 'Resend available in ' + cooldown + 's';
          cooldown -= 1;
          setTimeout(updateCountdown, 1000);
        } else {
          if (resendBtn) resendBtn.disabled = false;
          countdownEl.textContent = 'You can request a new code now';
        }
      }
      updateCountdown();
    }

    // Step 3 Password Strength Meter & Real-time Matching
    const newPw = document.getElementById('new_password');
    const confirmPw = document.getElementById('confirm_password');

    function calculateStrength(pw) {
      let segments = 0;
      const hasLength = pw.length >= 8;
      const hasUpper = /[A-Z]/.test(pw);
      const hasLower = /[a-z]/.test(pw);
      const hasNumber = /[0-9]/.test(pw);
      const hasSpecial = /[!@#$%^&*(),.?":{}|<>_\-+=\[\]\\\/`~]/.test(pw);

      if (hasLength) segments = 1;
      if (hasLength && hasUpper && hasLower && hasNumber) segments = 2;
      if (hasLength && hasUpper && hasLower && hasNumber && hasSpecial) segments = 3;

      return segments;
    }

    function updateStrengthMeter(pw) {
      const b1 = document.getElementById('bar1');
      const b2 = document.getElementById('bar2');
      const b3 = document.getElementById('bar3');
      const text = document.getElementById('strengthText');
      if (!b1 || !b2 || !b3 || !text) return;

      const segments = calculateStrength(pw);
      const BLUE = 'h-full rounded-full bg-[#2B5B84]';
      const GRAY = 'h-full rounded-full bg-slate-200';

      b1.className = segments >= 1 ? BLUE : GRAY;
      b2.className = segments >= 2 ? BLUE : GRAY;
      b3.className = segments >= 3 ? 'h-full rounded-full bg-emerald-600' : GRAY;

      if (segments === 0) {
        text.textContent = pw.length > 0 ? 'Strength: Too Short (< 8 chars)' : 'Password Strength: Empty';
        text.className = 'font-semibold text-slate-500';
      } else if (segments === 1) {
        text.textContent = 'Strength: Weak (Add uppercase, lowercase & number)';
        text.className = 'font-semibold text-amber-700';
      } else if (segments === 2) {
        text.textContent = 'Strength: Medium (Add special symbol)';
        text.className = 'font-semibold text-blue-700';
      } else {
        text.textContent = 'Strength: Strong (All requirements met)';
        text.className = 'font-semibold text-emerald-700';
      }
    }

    function checkPasswordMatch() {
      const notice = document.getElementById('matchNotice');
      const icon = document.getElementById('matchIcon');
      const text = document.getElementById('matchText');
      if (!notice || !icon || !text || !newPw || !confirmPw) return;

      if (!confirmPw.value) {
        notice.classList.add('hidden');
        return;
      }

      notice.classList.remove('hidden');
      if (newPw.value === confirmPw.value) {
        notice.className = 'text-[11px] font-semibold text-emerald-700 flex items-center gap-1';
        icon.textContent = 'check_circle';
        text.textContent = 'Passwords match';
      } else {
        notice.className = 'text-[11px] font-semibold text-rose-600 flex items-center gap-1';
        icon.textContent = 'cancel';
        text.textContent = 'Passwords do not match';
      }
    }

    if (newPw) {
      newPw.addEventListener('input', (e) => {
        updateStrengthMeter(e.target.value);
        checkPasswordMatch();
      });
    }

    if (confirmPw) {
      confirmPw.addEventListener('input', checkPasswordMatch);
    }
  </script>
</body>
</html>
