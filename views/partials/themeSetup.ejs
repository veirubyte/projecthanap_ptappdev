      'qr_code_scanner': 'scan',

      // Visibility
      'visibility': 'eye',
      'visibility_off': 'eye-off'
    };

    function toPascal(str) {
      var camel = str.replace(/-([a-z0-9])/gi, function(_, letter) { return letter.toUpperCase(); });
      return camel.charAt(0).toUpperCase() + camel.slice(1);
    }

    function initLucide(root) {
      var container = (root && root.querySelectorAll) ? root : document;
      
      // Seamlessly bridge material symbols to Lucide vector icons
      container.querySelectorAll('.material-symbols-outlined').forEach(function(el) {
        if (el.getAttribute('data-lucide-processed')) return;
        var text = (el.textContent || '').trim().toLowerCase();
        if (!text) return;
        var lucideName = iconMap[text] || text.replace(/_/g, '-');
        var pascal = toPascal(lucideName);

        // ONLY replace if Lucide actually HAS this icon in its library!
        if (window.lucide && window.lucide.icons && window.lucide.icons[pascal]) {
          var iconEl = document.createElement('i');
          iconEl.setAttribute('data-lucide', lucideName);
          iconEl.setAttribute('data-lucide-processed', 'true');
          iconEl.className = (el.className || '').replace('material-symbols-outlined', 'lucide-icon') + ' inline-block align-middle';
          if (el.id) iconEl.id = el.id;
          el.replaceWith(iconEl);
        } else {
          // If not in Lucide, mark as processed and KEEP it as Material Symbols so Google Fonts renders the glyph!
          el.setAttribute('data-lucide-processed', 'true');
        }
      });

      if (window.lucide && typeof window.lucide.createIcons === 'function') {
        window.lucide.createIcons();
      } else {
        setTimeout(function() {
          if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
          }
        }, 150);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() { initLucide(); });
    } else {
      initLucide();
    }

    // Auto-render newly added DOM elements (chat messages, image removal buttons, dynamic cards)
    if (typeof MutationObserver !== 'undefined') {
      var debounceTimer = null;
      var observer = new MutationObserver(function(mutations) {
        var shouldRender = false;
        for (var i = 0; i < mutations.length; i++) {
          if (mutations[i].addedNodes && mutations[i].addedNodes.length > 0) {
            shouldRender = true;
            break;
          }
        }
        if (shouldRender) {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(function() {
            initLucide();
          }, 50);
        }
      });
      observer.observe(document.documentElement, { childList: true, subtree: true });
    }

    window.renderLucide = initLucide;
  })();
</script>
