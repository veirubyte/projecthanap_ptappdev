<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Project HANAP - Campus Item Tracking, Lost and Found, and Asset Recovery System">
  <title><%= typeof title !== 'undefined' ? title : 'Project HANAP - Campus System' %></title>
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Custom Project Styles -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
  <!-- Main Navigation Bar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top shadow-sm main-navbar">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2 fw-bold tracking-tight" href="/">
        <span class="brand-icon bg-white text-primary rounded-circle d-flex align-items-center justify-content-center shadow-xs">
          <i class="bi bi-search"></i>
        </span>
        <span>Project <span class="text-warning">HANAP</span></span>
        <span class="badge bg-light text-primary fs-xs ms-1">Campus v1.0</span>
      </a>
      
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarMain">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'active fw-semibold' : '' %>" href="/">
              <i class="bi bi-house-door me-1"></i> Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath === '/about') ? 'active fw-semibold' : '' %>" href="/about">
              <i class="bi bi-info-circle me-1"></i> System Specs
            </a>
          </li>
        </ul>

        <!-- User Authentication Status Indicator -->
        <div class="d-flex align-items-center gap-2">
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <div class="dropdown">
              <button class="btn btn-outline-light dropdown-toggle d-flex align-items-center gap-2 py-1 px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle fs-5"></i>
                <div class="text-start lh-1">
                  <span class="d-block fw-semibold fs-sm"><%= currentUser.name %></span>
                  <small class="badge bg-warning text-dark fs-xs"><%= currentUser.role %></small>
                </div>
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                <li class="dropdown-header text-muted fs-xs">Signed in as</li>
                <li class="px-3 py-1 fw-bold fs-sm"><%= currentUser.email %></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/"><i class="bi bi-speedometer2 me-2"></i>My Dashboard</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <a class="dropdown-item text-danger" href="/auth/logout">
                    <i class="bi bi-box-arrow-right me-2"></i>Log Out
                  </a>
                </li>
              </ul>
            </div>
          <% } else { %>
            <a href="/auth/login" class="btn btn-outline-light btn-sm px-3 fw-medium">
              <i class="bi bi-box-arrow-in-right me-1"></i> Log In
            </a>
            <a href="/auth/register" class="btn btn-warning btn-sm px-3 fw-semibold text-dark">
              <i class="bi bi-person-plus me-1"></i> Register
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <!-- Global Alerts & Content Container -->
  <main class="flex-grow-1">
